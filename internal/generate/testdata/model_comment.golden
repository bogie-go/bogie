package domain

import (
	"encoding/json"
	"time"
)

// Comment is a comment. Imports nothing third-party: ids are int64s here and
// become bigint at the store boundary.
type Comment struct {
	ID          int64
	Body        string
	PostID      int64
	Score       int32
	PublishedAt time.Time
	Meta        json.RawMessage
	CreatedAt   time.Time
	UpdatedAt   time.Time
}

// Validate is the model's validations, as Rails would put them. Wrap every
// failure in ErrInvalid so a controller can answer 422 without knowing the
// rule:
//
//	return fmt.Errorf("%w: title is required", ErrInvalid)
func (c Comment) Validate() error {
	return nil
}
==> app/models/comments.go
package models

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"github.com/jackc/pgx/v5/pgtype"

	"example.com/blog/app/domain"
)

// Comments, as the domain sees them. Each method converts domain.Comment to and from
// the row type sqlc generated, and maps pgx's "no rows" to domain.ErrNotFound
// so callers never import pgx to ask a question.
//
// Written by `bogie g model`: overwritten whole on the next run. A
// hand-written addition goes in comments_extra.go, not here.

// CreateComment validates a comment, inserts it, and returns it with its id and
// timestamps. Validation runs on save, as Rails's does, so every caller
// gets it and none can forget it.
func (s *Store) CreateComment(ctx context.Context, c domain.Comment) (domain.Comment, error) {
	if err := c.Validate(); err != nil {
		return domain.Comment{}, err
	}
	row, err := s.q.CreateComment(ctx, CreateCommentParams{Body: c.Body, PostID: c.PostID, Score: c.Score, PublishedAt: pgtype.Timestamptz{Time: c.PublishedAt, Valid: true}, Meta: c.Meta})
	if err != nil {
		return domain.Comment{}, fmt.Errorf("models: create comment: %w", err)
	}
	return commentFromRow(row), nil
}

// GetComment finds one comment. An id that is not a valid id is simply not found.
func (s *Store) GetComment(ctx context.Context, id string) (domain.Comment, error) {
	pk, err := parseID(id)
	if err != nil {
		return domain.Comment{}, domain.ErrNotFound
	}
	row, err := s.q.GetComment(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.Comment{}, domain.ErrNotFound
	case err != nil:
		return domain.Comment{}, fmt.Errorf("models: get comment %s: %w", id, err)
	}
	return commentFromRow(row), nil
}

// ListComments returns the newest comments first, at most limit of them.
func (s *Store) ListComments(ctx context.Context, limit int32) ([]domain.Comment, error) {
	rows, err := s.q.ListComments(ctx, limit)
	if err != nil {
		return nil, fmt.Errorf("models: list comments: %w", err)
	}
	out := make([]domain.Comment, 0, len(rows))
	for _, r := range rows {
		out = append(out, commentFromRow(r))
	}
	return out, nil
}

// UpdateComment validates a comment, writes its columns, and returns the stored row.
func (s *Store) UpdateComment(ctx context.Context, c domain.Comment) (domain.Comment, error) {
	if err := c.Validate(); err != nil {
		return domain.Comment{}, err
	}
	pk := c.ID
	row, err := s.q.UpdateComment(ctx, UpdateCommentParams{ID: pk, Body: c.Body, PostID: c.PostID, Score: c.Score, PublishedAt: pgtype.Timestamptz{Time: c.PublishedAt, Valid: true}, Meta: c.Meta})
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.Comment{}, domain.ErrNotFound
	case err != nil:
		return domain.Comment{}, fmt.Errorf("models: update comment %v: %w", c.ID, err)
	}
	return commentFromRow(row), nil
}

// DeleteComment removes a comment, and says so if there was none.
func (s *Store) DeleteComment(ctx context.Context, id string) error {
	pk, err := parseID(id)
	if err != nil {
		return domain.ErrNotFound
	}
	n, err := s.q.DeleteComment(ctx, pk)
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return fmt.Errorf("%w: comment is still in use", domain.ErrInvalid)
		}
		return fmt.Errorf("models: delete comment %s: %w", id, err)
	}
	if n == 0 {
		return domain.ErrNotFound
	}
	return nil
}

func commentFromRow(r Comment) domain.Comment {
	return domain.Comment{
		ID:          r.ID,
		Body:        r.Body,
		PostID:      r.PostID,
		Score:       r.Score,
		PublishedAt: r.PublishedAt.Time,
		Meta:        r.Meta,
		CreatedAt:   r.CreatedAt.Time,
		UpdatedAt:   r.UpdatedAt.Time,
	}
}
