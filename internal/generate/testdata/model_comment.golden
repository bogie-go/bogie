	Describe("CreateComment", func() {
		Context("when a reference names nothing", func() {
			var missing models.Comment

			BeforeEach(func() {
				missing = factories.NewComment()
				missing.PostID = 999999999
			})

			It("is invalid", func() {
				_, err := store.CreateComment(GinkgoT().Context(), missing)
				Expect(err).To(MatchError(models.ErrInvalid))
			})
		})
	})

	// No round trip here: a comment belongs to a parent that has to be saved
	// first. Make the parent with its factory and add the specs, with the
	// reference set in the factory's "with" function.
})
