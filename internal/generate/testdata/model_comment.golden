==> db/adapter/comments.go
package adapter

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"github.com/jackc/pgx/v5/pgtype"

	"example.com/blog/app/models"
	"example.com/blog/db/sqlc"
)

// Comments, as the models see them. Each method converts models.Comment to and from
// the row type sqlc generated, and maps pgx's "no rows" to models.ErrNotFound
// so callers never import pgx to ask a question.
//
// Written by `bogie g model`: overwritten whole on the next run. A
// hand-written addition goes in comments_extra.go, not here.

// CreateComment validates a comment, inserts it, and returns it with its id and
// timestamps. Validation runs on save, so every caller
// gets it and none can forget it.
func (s *Store) CreateComment(ctx context.Context, c models.Comment) (models.Comment, error) {
	if err := c.Validate(); err != nil {
		return models.Comment{}, err
	}
	row, err := s.q.CreateComment(ctx, sqlc.CreateCommentParams{Body: c.Body, PostID: c.PostID, Score: c.Score, PublishedAt: pgtype.Timestamptz{Time: c.PublishedAt, Valid: true}, Meta: c.Meta})
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return models.Comment{}, fmt.Errorf("%w: post_id does not exist", models.ErrInvalid)
		}
		return models.Comment{}, fmt.Errorf("store: create comment: %w", err)
	}
	return commentFromRow(row), nil
}

// GetComment finds one comment. An id that is not a valid id is simply not found.
func (s *Store) GetComment(ctx context.Context, id string) (models.Comment, error) {
	pk, err := parseID(id)
	if err != nil {
		return models.Comment{}, models.ErrNotFound
	}
	row, err := s.q.GetComment(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return models.Comment{}, models.ErrNotFound
	case err != nil:
		return models.Comment{}, fmt.Errorf("store: get comment %s: %w", id, err)
	}
	return commentFromRow(row), nil
}

// ListComments returns the newest comments first, at most limit of them.
func (s *Store) ListComments(ctx context.Context, limit int32) ([]models.Comment, error) {
	rows, err := s.q.ListComments(ctx, limit)
	if err != nil {
		return nil, fmt.Errorf("store: list comments: %w", err)
	}
	out := make([]models.Comment, 0, len(rows))
	for _, r := range rows {
		out = append(out, commentFromRow(r))
	}
	return out, nil
}

// UpdateComment validates a comment, writes its columns, and returns the stored row.
func (s *Store) UpdateComment(ctx context.Context, c models.Comment) (models.Comment, error) {
	if err := c.Validate(); err != nil {
		return models.Comment{}, err
	}
	pk := c.ID
	row, err := s.q.UpdateComment(ctx, sqlc.UpdateCommentParams{ID: pk, Body: c.Body, PostID: c.PostID, Score: c.Score, PublishedAt: pgtype.Timestamptz{Time: c.PublishedAt, Valid: true}, Meta: c.Meta})
	var pgErr *pgconn.PgError
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return models.Comment{}, models.ErrNotFound
	case errors.As(err, &pgErr) && pgErr.Code == "23503":
		return models.Comment{}, fmt.Errorf("%w: post_id does not exist", models.ErrInvalid)
	case err != nil:
		return models.Comment{}, fmt.Errorf("store: update comment %v: %w", c.ID, err)
	}
	return commentFromRow(row), nil
}

// DeleteComment removes a comment, and says so if there was none.
func (s *Store) DeleteComment(ctx context.Context, id string) error {
	pk, err := parseID(id)
	if err != nil {
		return models.ErrNotFound
	}
	n, err := s.q.DeleteComment(ctx, pk)
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return fmt.Errorf("%w: comment is still in use", models.ErrInvalid)
		}
		return fmt.Errorf("store: delete comment %s: %w", id, err)
	}
	if n == 0 {
		return models.ErrNotFound
	}
	return nil
}

func commentFromRow(r sqlc.Comment) models.Comment {
	return models.Comment{
		ID:          r.ID,
		Body:        r.Body,
		PostID:      r.PostID,
		Score:       r.Score,
		PublishedAt: r.PublishedAt.Time,
		Meta:        r.Meta,
		CreatedAt:   r.CreatedAt.Time,
		UpdatedAt:   r.UpdatedAt.Time,
	}
}
