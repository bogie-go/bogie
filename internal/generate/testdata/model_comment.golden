package factories

import (
	"context"
	"time"

	"example.com/blog/app/models"
	"example.com/blog/db/adapter"
)

// NewComment is a valid comment that is not saved: every attribute has a default,
// and "with" overrides what the spec cares about.
//
// Written once by `bogie g model` and yours to edit: add an attribute's
// default here when you add the column. Running the generator again leaves a
// changed file alone unless --force. The exception is `bogie model:sync`:
// when a migration adds or drops a column it merges the new default into this
// file and keeps your edits (a clash leaves conflict markers).
//
// Left at zero: PostID. The parent has to exist first, so set it from the
// parent's own factory:
//
//	factories.Comment(t, s, func(v *models.Comment) { v.PostID = parent.ID })
//
// Placeholders: the datetime defaults (PublishedAt) are one fixed instant. Set real
// times where a spec depends on them, such as a window that starts before it ends.
func NewComment(with ...func(*models.Comment)) models.Comment {
	record := models.Comment{
		Body:        Sequence("body "),
		Score:       1,
		PublishedAt: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC),
		Meta:        []byte("{}"),
	}
	for _, f := range with {
		f(&record)
	}
	return record
}

// Comment saves a NewComment through the real store and fails the spec if it
// cannot, so a spec reads as its arrangement and nothing else.
func Comment(t T, s *adapter.Store, with ...func(*models.Comment)) models.Comment {
	t.Helper()
	created, err := s.CreateComment(context.Background(), NewComment(with...))
	if err != nil {
		t.Fatal(err)
	}
	return created
}
