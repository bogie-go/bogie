package models_test

import (
	"context"
	"errors"
	"testing"

	"example.com/blog/app/domain"
	"example.com/blog/test/testdb"
)

// Whatever the id looks like, a comment that is not there is ErrNotFound, and a
// caller cannot tell a malformed id from a well-formed one that names nothing.
func TestUnknownCommentsAreNotFound(t *testing.T) {
	store := testdb.Store(t)
	ctx := context.Background()

	for _, id := range []string{"nope", "", "999999999"} {
		if _, err := store.GetComment(ctx, id); !errors.Is(err, domain.ErrNotFound) {
			t.Errorf("GetComment(%q): err = %v, want ErrNotFound", id, err)
		}
		if err := store.DeleteComment(ctx, id); !errors.Is(err, domain.ErrNotFound) {
			t.Errorf("DeleteComment(%q): err = %v, want ErrNotFound", id, err)
		}
	}

	if _, err := store.UpdateComment(ctx, domain.Comment{ID: 999999999}); !errors.Is(err, domain.ErrNotFound) {
		t.Errorf("UpdateComment(%d): err = %v, want ErrNotFound", 999999999, err)
	}
}

