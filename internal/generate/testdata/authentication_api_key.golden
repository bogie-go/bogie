package models

import (
	"context"
	"errors"
	"testing"

	"example.com/blog/app/domain"
)

// Whatever the id looks like, a api_key that is not there is ErrNotFound, and a
// caller cannot tell a malformed id from a well-formed one that names nothing.
func TestUnknownApiKeysAreNotFound(t *testing.T) {
	store := testStore(t)
	ctx := context.Background()

	for _, id := range []string{"nope", "", "00000000-0000-4000-8000-000000000000"} {
		if _, err := store.GetApiKey(ctx, id); !errors.Is(err, domain.ErrNotFound) {
			t.Errorf("GetApiKey(%q): err = %v, want ErrNotFound", id, err)
		}
		if err := store.DeleteApiKey(ctx, id); !errors.Is(err, domain.ErrNotFound) {
			t.Errorf("DeleteApiKey(%q): err = %v, want ErrNotFound", id, err)
		}
		if _, err := store.UpdateApiKey(ctx, domain.ApiKey{ID: id}); !errors.Is(err, domain.ErrNotFound) {
			t.Errorf("UpdateApiKey(%q): err = %v, want ErrNotFound", id, err)
		}
	}
}

