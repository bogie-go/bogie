		Entry("an empty id", ""),
		Entry("a well-formed id that names nothing", "999999999"),
	)

	Describe("UpdateApiKey", func() {
		Context("when the api_key is not there", func() {
			var missing domain.ApiKey

			BeforeEach(func() {
