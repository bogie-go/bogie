package domain

import (
	"time"
)

// ApiKey is a api_key. Imports nothing third-party: ids are int64s here and
// become bigint at the store boundary.
type ApiKey struct {
	ID        int64
	Name      string
	Prefix    string
	Digest    string
	CreatedAt time.Time
	UpdatedAt time.Time
}

// Validate is the model's validations, as Rails would put them. Wrap every
// failure in ErrInvalid so a controller can answer 422 without knowing the
// rule:
//
//	return fmt.Errorf("%w: title is required", ErrInvalid)
func (a ApiKey) Validate() error {
	return nil
}
