		})

		It("lists it", func() {
			all, err := store.ListApiKeys(GinkgoT().Context(), 10)
			Expect(err).NotTo(HaveOccurred())
			Expect(all).To(HaveLen(1))
			Expect(all[0].ID).To(Equal(record.ID))
		})

		It("updates it", func() {
			record.Name = "Edited"
			updated, err := store.UpdateApiKey(GinkgoT().Context(), record)
			Expect(err).NotTo(HaveOccurred())
			Expect(updated.ID).To(Equal(record.ID))
			Expect(updated.Name).To(BeEquivalentTo("Edited"))
		})

		It("deletes it", func() {
			Expect(store.DeleteApiKey(GinkgoT().Context(), id)).To(Succeed())
			_, err := store.GetApiKey(GinkgoT().Context(), id)
			Expect(err).To(MatchError(domain.ErrNotFound))
		})
	})
})
