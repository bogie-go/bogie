package models

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"

	"example.com/blog/app/domain"
)

// ApiKeys, as the domain sees them. Each method converts domain.ApiKey to and from
// the row type sqlc generated, and maps pgx's "no rows" to domain.ErrNotFound
// so callers never import pgx to ask a question.
//
// Written by `bogie g model`: overwritten whole on the next run. A
// hand-written addition goes in api_keys_extra.go, not here.

// CreateApiKey validates a api_key, inserts it, and returns it with its id and
// timestamps. Validation runs on save, as Rails's does, so every caller
// gets it and none can forget it.
func (s *Store) CreateApiKey(ctx context.Context, a domain.ApiKey) (domain.ApiKey, error) {
	if err := a.Validate(); err != nil {
		return domain.ApiKey{}, err
	}
	row, err := s.q.CreateApiKey(ctx, CreateApiKeyParams{Name: a.Name, Prefix: a.Prefix, Digest: a.Digest})
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23505" {
			return domain.ApiKey{}, fmt.Errorf("%w: prefix is already taken", domain.ErrInvalid)
		}
		return domain.ApiKey{}, fmt.Errorf("models: create api_key: %w", err)
	}
	return api_keyFromRow(row), nil
}

// GetApiKey finds one api_key. An id that is not a valid id is simply not found.
func (s *Store) GetApiKey(ctx context.Context, id string) (domain.ApiKey, error) {
	pk, err := parseID(id)
	if err != nil {
		return domain.ApiKey{}, domain.ErrNotFound
	}
	row, err := s.q.GetApiKey(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.ApiKey{}, domain.ErrNotFound
	case err != nil:
		return domain.ApiKey{}, fmt.Errorf("models: get api_key %s: %w", id, err)
	}
	return api_keyFromRow(row), nil
}

// ListApiKeys returns the newest api_keys first, at most limit of them.
func (s *Store) ListApiKeys(ctx context.Context, limit int32) ([]domain.ApiKey, error) {
	rows, err := s.q.ListApiKeys(ctx, limit)
	if err != nil {
		return nil, fmt.Errorf("models: list api_keys: %w", err)
	}
	out := make([]domain.ApiKey, 0, len(rows))
	for _, r := range rows {
		out = append(out, api_keyFromRow(r))
	}
	return out, nil
}

// UpdateApiKey validates a api_key, writes its columns, and returns the stored row.
func (s *Store) UpdateApiKey(ctx context.Context, a domain.ApiKey) (domain.ApiKey, error) {
	if err := a.Validate(); err != nil {
		return domain.ApiKey{}, err
	}
	pk := a.ID
	row, err := s.q.UpdateApiKey(ctx, UpdateApiKeyParams{ID: pk, Name: a.Name, Prefix: a.Prefix, Digest: a.Digest})
	var pgErr *pgconn.PgError
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.ApiKey{}, domain.ErrNotFound
	case errors.As(err, &pgErr) && pgErr.Code == "23505":
		return domain.ApiKey{}, fmt.Errorf("%w: prefix is already taken", domain.ErrInvalid)
	case err != nil:
		return domain.ApiKey{}, fmt.Errorf("models: update api_key %v: %w", a.ID, err)
	}
	return api_keyFromRow(row), nil
}

// DeleteApiKey removes a api_key, and says so if there was none.
func (s *Store) DeleteApiKey(ctx context.Context, id string) error {
	pk, err := parseID(id)
	if err != nil {
		return domain.ErrNotFound
	}
	n, err := s.q.DeleteApiKey(ctx, pk)
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return fmt.Errorf("%w: api_key is still in use", domain.ErrInvalid)
		}
		return fmt.Errorf("models: delete api_key %s: %w", id, err)
	}
	if n == 0 {
		return domain.ErrNotFound
	}
	return nil
}

func api_keyFromRow(r ApiKey) domain.ApiKey {
	return domain.ApiKey{
		ID:        r.ID,
		Name:      r.Name,
		Prefix:    r.Prefix,
		Digest:    r.Digest,
		CreatedAt: r.CreatedAt.Time,
		UpdatedAt: r.UpdatedAt.Time,
	}
}

// GetApiKeyByPrefix finds the key a presented "<prefix>.<secret>" names, by
// its prefix; the service compares the secret against the digest.
func (s *Store) GetApiKeyByPrefix(ctx context.Context, prefix string) (domain.ApiKey, error) {
	row, err := s.q.GetApiKeyByPrefix(ctx, prefix)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.ApiKey{}, domain.ErrNotFound
	case err != nil:
		return domain.ApiKey{}, fmt.Errorf("models: get api key by prefix: %w", err)
	}
	return api_keyFromRow(row), nil
}
