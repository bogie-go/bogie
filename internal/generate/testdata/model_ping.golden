==> db/adapter/pings.go
package adapter

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"

	"example.com/blog/app/models"
	"example.com/blog/db/sqlc"
)

// Pings, as the models see them. Each method converts models.Ping to and from
// the row type sqlc generated, and maps pgx's "no rows" to models.ErrNotFound
// so callers never import pgx to ask a question.
//
// Written by `bogie g model`: overwritten whole on the next run. A
// hand-written addition goes in pings_extra.go, not here.

// CreatePing validates a ping, inserts it, and returns it with its id and
// timestamps. Validation runs on save, so every caller
// gets it and none can forget it.
func (s *Store) CreatePing(ctx context.Context, p models.Ping) (models.Ping, error) {
	if err := p.Validate(); err != nil {
		return models.Ping{}, err
	}
	row, err := s.q.CreatePing(ctx)
	if err != nil {
		return models.Ping{}, fmt.Errorf("store: create ping: %w", err)
	}
	return pingFromRow(row), nil
}

// GetPing finds one ping. An id that is not a valid id is simply not found.
func (s *Store) GetPing(ctx context.Context, id string) (models.Ping, error) {
	pk, err := parseID(id)
	if err != nil {
		return models.Ping{}, models.ErrNotFound
	}
	row, err := s.q.GetPing(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return models.Ping{}, models.ErrNotFound
	case err != nil:
		return models.Ping{}, fmt.Errorf("store: get ping %s: %w", id, err)
	}
	return pingFromRow(row), nil
}

// ListPings returns the newest pings first, at most limit of them.
func (s *Store) ListPings(ctx context.Context, limit int32) ([]models.Ping, error) {
	rows, err := s.q.ListPings(ctx, limit)
	if err != nil {
		return nil, fmt.Errorf("store: list pings: %w", err)
	}
	out := make([]models.Ping, 0, len(rows))
	for _, r := range rows {
		out = append(out, pingFromRow(r))
	}
	return out, nil
}

// UpdatePing validates a ping, writes its columns, and returns the stored row.
func (s *Store) UpdatePing(ctx context.Context, p models.Ping) (models.Ping, error) {
	if err := p.Validate(); err != nil {
		return models.Ping{}, err
	}
	pk := p.ID
	row, err := s.q.UpdatePing(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return models.Ping{}, models.ErrNotFound
	case err != nil:
		return models.Ping{}, fmt.Errorf("store: update ping %v: %w", p.ID, err)
	}
	return pingFromRow(row), nil
}

// DeletePing removes a ping, and says so if there was none.
func (s *Store) DeletePing(ctx context.Context, id string) error {
	pk, err := parseID(id)
	if err != nil {
		return models.ErrNotFound
	}
	n, err := s.q.DeletePing(ctx, pk)
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return fmt.Errorf("%w: ping is still in use", models.ErrInvalid)
		}
		return fmt.Errorf("store: delete ping %s: %w", id, err)
	}
	if n == 0 {
		return models.ErrNotFound
	}
	return nil
}

func pingFromRow(r sqlc.Ping) models.Ping {
	return models.Ping{
		ID:        r.ID,
		CreatedAt: r.CreatedAt.Time,
		UpdatedAt: r.UpdatedAt.Time,
	}
}
