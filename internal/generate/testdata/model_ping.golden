package adapter_test

import (
	"strconv"

	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"

	"example.com/blog/app/models"
	"example.com/blog/test/factories"
)

var _ = Describe("Pings", func() {
	Describe("GetPing", func() {
		DescribeTable("returns ErrNotFound",
			func(id string) {
				_, err := store.GetPing(GinkgoT().Context(), id)
				Expect(err).To(MatchError(models.ErrNotFound))
			},
			Entry("when the id is not a number", "nope"),
			Entry("when the id is empty", ""),
			Entry("when no ping has that id", "999999999"),
		)

		Context("with a saved ping", func() {
			var record models.Ping

			BeforeEach(func() {
				record = factories.Ping(GinkgoT(), store)
			})

			It("finds the ping by id", func() {
				Expect(store.GetPing(GinkgoT().Context(), strconv.FormatInt(record.ID, 10))).To(Equal(record))
			})
		})
	})

	Describe("ListPings", func() {
		Context("with a saved ping", func() {
			var record models.Ping

			BeforeEach(func() {
				record = factories.Ping(GinkgoT(), store)
			})

			It("includes the saved ping", func() {
				all, err := store.ListPings(GinkgoT().Context(), 10)
				Expect(err).NotTo(HaveOccurred())
				Expect(all).To(HaveLen(1))
				Expect(all[0].ID).To(Equal(record.ID))
			})
		})
	})

	Describe("UpdatePing", func() {
		Context("with a saved ping", func() {
			var record models.Ping

			BeforeEach(func() {
				record = factories.Ping(GinkgoT(), store)
			})

			It("saves the ping", func() {
				updated, err := store.UpdatePing(GinkgoT().Context(), record)
				Expect(err).NotTo(HaveOccurred())
				Expect(updated.ID).To(Equal(record.ID))
			})
		})

		Context("when the ping is not there", func() {
			var missing models.Ping

			BeforeEach(func() {
				missing = factories.NewPing()
				missing.ID = 999999999
			})

			It("is not found", func() {
				_, err := store.UpdatePing(GinkgoT().Context(), missing)
				Expect(err).To(MatchError(models.ErrNotFound))
			})
		})
	})

	Describe("DeletePing", func() {
		DescribeTable("returns ErrNotFound",
			func(id string) {
				Expect(store.DeletePing(GinkgoT().Context(), id)).To(MatchError(models.ErrNotFound))
			},
			Entry("when the id is not a number", "nope"),
			Entry("when the id is empty", ""),
			Entry("when no ping has that id", "999999999"),
		)

		Context("with a saved ping", func() {
			var record models.Ping

			BeforeEach(func() {
				record = factories.Ping(GinkgoT(), store)
			})

			It("removes the ping", func() {
				id := strconv.FormatInt(record.ID, 10)
				Expect(store.DeletePing(GinkgoT().Context(), id)).To(Succeed())
				_, err := store.GetPing(GinkgoT().Context(), id)
				Expect(err).To(MatchError(models.ErrNotFound))
			})
		})
	})
})
