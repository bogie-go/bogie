package factories

import (
	"context"

	"example.com/blog/app/models"
	"example.com/blog/db/adapter"
)

// NewPing is a valid ping that is not saved: every attribute has a default,
// and "with" overrides what the spec cares about.
//
// Written once by `bogie g model` and yours to edit: add an attribute's
// default here when you add the column. Running the generator again leaves a
// changed file alone unless --force.
func NewPing(with ...func(*models.Ping)) models.Ping {
	record := models.Ping{}
	for _, f := range with {
		f(&record)
	}
	return record
}

// Ping saves a NewPing through the real store and fails the spec if it
// cannot, so a spec reads as its arrangement and nothing else.
func Ping(t T, s *adapter.Store, with ...func(*models.Ping)) models.Ping {
	t.Helper()
	created, err := s.CreatePing(context.Background(), NewPing(with...))
	if err != nil {
		t.Fatal(err)
	}
	return created
}
