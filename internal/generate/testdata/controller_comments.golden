package controllers_test

import (
	"net/http"
	"net/http/httptest"

	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"
)

var _ = Describe("GET /comments", func() {
	It("is mounted", func() {
		rec := httptest.NewRecorder()
		app.Server.Router.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/comments", nil))

		Expect(rec.Code).NotTo(Equal(http.StatusNotFound))
	})
})

var _ = Describe("GET /comments/1", func() {
	It("is mounted", func() {
		rec := httptest.NewRecorder()
		app.Server.Router.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/comments/1", nil))

		Expect(rec.Code).NotTo(Equal(http.StatusNotFound))
	})
})

var _ = Describe("POST /comments", func() {
	It("is mounted", func() {
		rec := httptest.NewRecorder()
		app.Server.Router.ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/comments", nil))

		Expect(rec.Code).NotTo(Equal(http.StatusNotFound))
	})
})

var _ = Describe("GET /comments/search", func() {
	It("is mounted", func() {
		rec := httptest.NewRecorder()
		app.Server.Router.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/comments/search", nil))

		Expect(rec.Code).NotTo(Equal(http.StatusNotFound))
	})
})
