package controllers

import (
	"log/slog"
	"net/http"

	"github.com/gin-gonic/gin"

	"example.com/blog/app/views"
)

// CommentsController is the HTTP surface of comments: its dependencies, its routes
// and its actions, one Rails controller in one file. Dependencies are small
// interfaces declared here (rule 2), holding only the methods the actions
// call, and the real thing is passed in from app/application.go, where this
// controller is wired:
//
//	type commentsService interface {
//		Get(ctx context.Context, id string) (models.Thing, error)
//	}
type CommentsController struct {
	Log *slog.Logger
}

// NewCommentsController builds the controller.
func NewCommentsController(log *slog.Logger) *CommentsController {
	return &CommentsController{Log: log}
}

// SetupRoutes mounts the controller under its own prefix. Middleware the
// whole controller needs goes here; which group it sits in, and so how it is
// exposed, is decided by the routes.go that calls this.
func (ctl *CommentsController) SetupRoutes(router *gin.RouterGroup) {
	comments := router.Group("/comments")
	comments.GET("", ctl.Index)
	comments.GET("/:id", ctl.Show)
	comments.POST("", ctl.Create)
	comments.GET("/search", ctl.Search)
}

// Index handles GET /comments.
//
// A handler converts HTTP into domain values, calls one service function,
// and converts the result back. Nothing below app/controllers sees
// *gin.Context (rule 5).
func (ctl *CommentsController) Index(c *gin.Context) {
	c.JSON(http.StatusNotImplemented, views.ErrorMessage("comments#index is not implemented yet"))
}

// Show handles GET /comments/:id.
//
// A handler converts HTTP into domain values, calls one service function,
// and converts the result back. Nothing below app/controllers sees
// *gin.Context (rule 5).
func (ctl *CommentsController) Show(c *gin.Context) {
	c.JSON(http.StatusNotImplemented, views.ErrorMessage("comments#show is not implemented yet"))
}

// Create handles POST /comments.
//
// A handler converts HTTP into domain values, calls one service function,
// and converts the result back. Nothing below app/controllers sees
// *gin.Context (rule 5).
func (ctl *CommentsController) Create(c *gin.Context) {
	c.JSON(http.StatusNotImplemented, views.ErrorMessage("comments#create is not implemented yet"))
}

// Search handles GET /comments/search.
//
// A handler converts HTTP into domain values, calls one service function,
// and converts the result back. Nothing below app/controllers sees
// *gin.Context (rule 5).
func (ctl *CommentsController) Search(c *gin.Context) {
	c.JSON(http.StatusNotImplemented, views.ErrorMessage("comments#search is not implemented yet"))
}
