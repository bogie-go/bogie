package policies_test

import (
	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"

	"example.com/blog/app/models"
	"example.com/blog/app/policies"
)

// One row per role and action, for the actor who owns the post and for one
// who does not. The default allows only the owner; a role is not a grant.
var _ = DescribeTable("post policy",
	func(role, action, id string, allow bool) {
		actor := policies.Actor{ID: id, Role: role}
		post := &models.Post{UserID: "user-1"}
		var got bool
		switch action {
		case "index":
			got = policies.Post.CanIndex(actor, post)
		case "show":
			got = policies.Post.CanShow(actor, post)
		case "create":
			got = policies.Post.CanCreate(actor, post)
		case "update":
			got = policies.Post.CanUpdate(actor, post)
		case "destroy":
			got = policies.Post.CanDestroy(actor, post)
		default:
			Fail("unknown action " + action)
		}
		Expect(got).To(Equal(allow))
	},
	Entry("member may index their own", "member", "index", "user-1", true),
	Entry("member may not index another's", "member", "index", "user-2", false),
	Entry("member may show their own", "member", "show", "user-1", true),
	Entry("member may not show another's", "member", "show", "user-2", false),
	Entry("member may create their own", "member", "create", "user-1", true),
	Entry("member may not create another's", "member", "create", "user-2", false),
	Entry("member may update their own", "member", "update", "user-1", true),
	Entry("member may not update another's", "member", "update", "user-2", false),
	Entry("member may destroy their own", "member", "destroy", "user-1", true),
	Entry("member may not destroy another's", "member", "destroy", "user-2", false),
	Entry("admin may index their own", "admin", "index", "user-1", true),
	Entry("admin may not index another's", "admin", "index", "user-2", false),
	Entry("admin may show their own", "admin", "show", "user-1", true),
	Entry("admin may not show another's", "admin", "show", "user-2", false),
	Entry("admin may create their own", "admin", "create", "user-1", true),
	Entry("admin may not create another's", "admin", "create", "user-2", false),
	Entry("admin may update their own", "admin", "update", "user-1", true),
	Entry("admin may not update another's", "admin", "update", "user-2", false),
	Entry("admin may destroy their own", "admin", "destroy", "user-1", true),
	Entry("admin may not destroy another's", "admin", "destroy", "user-2", false),
)

var _ = Describe("post policy, at the edges", func() {
	It("denies an actor with no id", func() {
		Expect(policies.Post.CanShow(policies.Actor{ID: "", Role: "member"}, &models.Post{UserID: "user-1"})).To(BeFalse())
	})

	It("denies a nil post", func() {
		Expect(policies.Post.CanShow(policies.Actor{ID: "user-1", Role: "member"}, nil)).To(BeFalse())
	})
})
==> app/services/posts/posts.go
// Package posts is the post resource's service: it checks the policy, then
// calls the store. It knows nothing about HTTP. A denial is policies.ErrDenied,
// which the controller maps to 403.
package posts

import (
	"context"
	"log/slog"

	"example.com/blog/app/models"
	"example.com/blog/app/policies"
)

// store is the slice of persistence this service uses, declared here, next
// to its caller. *adapter.Store satisfies it.
type store interface {
	CreatePost(ctx context.Context, p models.Post) (models.Post, error)
	GetPost(ctx context.Context, id string) (models.Post, error)
	ListPosts(ctx context.Context, limit int32) ([]models.Post, error)
	UpdatePost(ctx context.Context, p models.Post) (models.Post, error)
	DeletePost(ctx context.Context, id string) error
}

// Service checks the post policy and then saves or loads.
type Service struct {
	store store
	log   *slog.Logger
}

// New builds the service.
func New(store store, log *slog.Logger) *Service {
	return &Service{store: store, log: log}
}

func (s *Service) deny(ctx context.Context, action string, actor policies.Actor) {
	s.log.InfoContext(ctx, "post: denied", "action", action, "actor", actor.ID, "role", actor.Role)
}

// Index returns the posts the actor may list: the ones they own.
func (s *Service) Index(ctx context.Context, actor policies.Actor, limit int32) ([]models.Post, error) {
	posts, err := s.store.ListPosts(ctx, limit)
	if err != nil {
		return nil, err
	}
	owned := make([]models.Post, 0, len(posts))
	for i := range posts {
		if policies.Post.CanIndex(actor, &posts[i]) {
			owned = append(owned, posts[i])
		}
	}
	return owned, nil
}

// Show returns the post, or policies.ErrDenied when the actor may not read it.
// A missing post is models.ErrNotFound, so a caller can tell the two apart.
func (s *Service) Show(ctx context.Context, actor policies.Actor, id string) (models.Post, error) {
	p, err := s.store.GetPost(ctx, id)
	if err != nil {
		return models.Post{}, err
	}
	if !policies.Post.CanShow(actor, &p) {
		s.deny(ctx, "show", actor)
		return models.Post{}, policies.ErrDenied
	}
	return p, nil
}

// Create saves p with the actor as its owner. The body cannot choose a
// different owner: UserID is set from the actor before the policy is asked.
func (s *Service) Create(ctx context.Context, actor policies.Actor, p models.Post) (models.Post, error) {
	p.UserID = actor.ID
	if !policies.Post.CanCreate(actor, &p) {
		s.deny(ctx, "create", actor)
		return models.Post{}, policies.ErrDenied
	}
	return s.store.CreatePost(ctx, p)
}

// Update saves p when the actor may change it. UserID is the one the
// record already had; the caller keeps it.
func (s *Service) Update(ctx context.Context, actor policies.Actor, p models.Post) (models.Post, error) {
	if !policies.Post.CanUpdate(actor, &p) {
		s.deny(ctx, "update", actor)
		return models.Post{}, policies.ErrDenied
	}
	return s.store.UpdatePost(ctx, p)
}

// Destroy deletes the post when the actor owns it.
func (s *Service) Destroy(ctx context.Context, actor policies.Actor, id string) error {
	p, err := s.store.GetPost(ctx, id)
	if err != nil {
		return err
	}
	if !policies.Post.CanDestroy(actor, &p) {
		s.deny(ctx, "destroy", actor)
		return policies.ErrDenied
	}
	return s.store.DeletePost(ctx, id)
}
