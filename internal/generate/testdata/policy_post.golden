package posts_test

import (
	"context"
	"io"
	"log/slog"

	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"

	"example.com/blog/app/models"
	"example.com/blog/app/policies"
	"example.com/blog/app/services/posts"
)

// fakeStore is the store interface the service declares, in memory.
type fakeStore struct {
	p     models.Post
	saved bool
}

func (f *fakeStore) CreatePost(_ context.Context, p models.Post) (models.Post, error) {
	p.ID = int64(1)
	f.p = p
	f.saved = true
	return p, nil
}

func (f *fakeStore) GetPost(_ context.Context, id string) (models.Post, error) {
	if !f.saved || id != "1" {
		return models.Post{}, models.ErrNotFound
	}
	return f.p, nil
}

func (f *fakeStore) ListPosts(_ context.Context, _ int32) ([]models.Post, error) {
	if !f.saved {
		return nil, nil
	}
	return []models.Post{f.p}, nil
}

func (f *fakeStore) UpdatePost(_ context.Context, p models.Post) (models.Post, error) {
	f.p = p
	return p, nil
}

func (f *fakeStore) DeletePost(_ context.Context, id string) error {
	if !f.saved || id != "1" {
		return models.ErrNotFound
	}
	f.saved = false
	return nil
}

var _ = Describe("Service", func() {
	var (
		fake *fakeStore
		svc  *posts.Service
	)

	BeforeEach(func() {
		fake = &fakeStore{saved: true, p: models.Post{ID: int64(1), UserID: "user-1"}}
		svc = posts.New(fake, slog.New(slog.NewTextHandler(io.Discard, nil)))
	})

	Describe("Show", func() {
		It("returns the post to its owner", func() {
			got, err := svc.Show(context.Background(), policies.Actor{ID: "user-1", Role: "member"}, "1")
			Expect(err).NotTo(HaveOccurred())
			Expect(got.UserID).To(Equal("user-1"))
		})

		It("denies someone else", func() {
			_, err := svc.Show(context.Background(), policies.Actor{ID: "user-2", Role: "member"}, "1")
			Expect(err).To(MatchError(policies.ErrDenied))
		})

		It("is not found when nothing has that id", func() {
			_, err := svc.Show(context.Background(), policies.Actor{ID: "user-1", Role: "member"}, "missing")
			Expect(err).To(MatchError(models.ErrNotFound))
		})
	})

	Describe("Create", func() {
		It("stamps the actor as the owner", func() {
			got, err := svc.Create(context.Background(), policies.Actor{ID: "user-1", Role: "member"}, models.Post{})
			Expect(err).NotTo(HaveOccurred())
			Expect(got.UserID).To(Equal("user-1"))
		})

		It("denies an actor with no id", func() {
			_, err := svc.Create(context.Background(), policies.Actor{Role: "member"}, models.Post{})
			Expect(err).To(MatchError(policies.ErrDenied))
		})
	})
})
