package domain

import (
	"time"
)

// Thing is a thing. Imports nothing third-party: ids are int64s here and
// become bigint at the store boundary.
type Thing struct {
	ID        int64
	Name      string
	CreatedAt time.Time
	UpdatedAt time.Time
}

// Validate is the model's validations, as Rails would put them. Wrap every
// failure in ErrInvalid so a controller can answer 422 without knowing the
// rule:
//
//	return fmt.Errorf("%w: title is required", ErrInvalid)
func (t Thing) Validate() error {
	return nil
}
==> app/models/things.go
package models

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"

	"example.com/blog/app/domain"
	"example.com/blog/db/sqlc"
)

// Things, as the domain sees them. Each method converts domain.Thing to and from
// the row type sqlc generated, and maps pgx's "no rows" to domain.ErrNotFound
// so callers never import pgx to ask a question.
//
// Written by `bogie g model`: overwritten whole on the next run. A
// hand-written addition goes in things_extra.go, not here.

// CreateThing validates a thing, inserts it, and returns it with its id and
// timestamps. Validation runs on save, as Rails's does, so every caller
// gets it and none can forget it.
func (s *Store) CreateThing(ctx context.Context, t domain.Thing) (domain.Thing, error) {
	if err := t.Validate(); err != nil {
		return domain.Thing{}, err
	}
	row, err := s.q.CreateThing(ctx, t.Name)
	if err != nil {
		return domain.Thing{}, fmt.Errorf("models: create thing: %w", err)
	}
	return thingFromRow(row), nil
}

// GetThing finds one thing. An id that is not a valid id is simply not found.
func (s *Store) GetThing(ctx context.Context, id string) (domain.Thing, error) {
	pk, err := parseID(id)
	if err != nil {
		return domain.Thing{}, domain.ErrNotFound
	}
	row, err := s.q.GetThing(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.Thing{}, domain.ErrNotFound
	case err != nil:
		return domain.Thing{}, fmt.Errorf("models: get thing %s: %w", id, err)
	}
	return thingFromRow(row), nil
}

// ListThings returns the newest things first, at most limit of them.
func (s *Store) ListThings(ctx context.Context, limit int32) ([]domain.Thing, error) {
	rows, err := s.q.ListThings(ctx, limit)
	if err != nil {
		return nil, fmt.Errorf("models: list things: %w", err)
	}
	out := make([]domain.Thing, 0, len(rows))
	for _, r := range rows {
		out = append(out, thingFromRow(r))
	}
	return out, nil
}

// UpdateThing validates a thing, writes its columns, and returns the stored row.
func (s *Store) UpdateThing(ctx context.Context, t domain.Thing) (domain.Thing, error) {
	if err := t.Validate(); err != nil {
		return domain.Thing{}, err
	}
	pk := t.ID
	row, err := s.q.UpdateThing(ctx, sqlc.UpdateThingParams{ID: pk, Name: t.Name})
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.Thing{}, domain.ErrNotFound
	case err != nil:
		return domain.Thing{}, fmt.Errorf("models: update thing %v: %w", t.ID, err)
	}
	return thingFromRow(row), nil
}

// DeleteThing removes a thing, and says so if there was none.
func (s *Store) DeleteThing(ctx context.Context, id string) error {
	pk, err := parseID(id)
	if err != nil {
		return domain.ErrNotFound
	}
	n, err := s.q.DeleteThing(ctx, pk)
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return fmt.Errorf("%w: thing is still in use", domain.ErrInvalid)
		}
		return fmt.Errorf("models: delete thing %s: %w", id, err)
	}
	if n == 0 {
		return domain.ErrNotFound
	}
	return nil
}

func thingFromRow(r sqlc.Thing) domain.Thing {
	return domain.Thing{
		ID:        r.ID,
		Name:      r.Name,
		CreatedAt: r.CreatedAt.Time,
		UpdatedAt: r.UpdatedAt.Time,
	}
}
==> app/models/things_test.go
package models_test

import (
	"strconv"

	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"

	"example.com/blog/app/domain"
	"example.com/blog/test/factories"
)

var _ = Describe("Things", func() {
	Describe("GetThing", func() {
		DescribeTable("is not found for",
			func(id string) {
				_, err := store.GetThing(GinkgoT().Context(), id)
				Expect(err).To(MatchError(domain.ErrNotFound))
			},
			Entry("a malformed id", "nope"),
			Entry("an empty id", ""),
			Entry("a well-formed id that names nothing", "999999999"),
		)

		Context("with a saved thing", func() {
			var record domain.Thing

			BeforeEach(func() {
				record = factories.Thing(GinkgoT(), store)
			})

			It("finds the thing by id", func() {
				Expect(store.GetThing(GinkgoT().Context(), strconv.FormatInt(record.ID, 10))).To(Equal(record))
			})
		})
	})

	Describe("ListThings", func() {
		Context("with a saved thing", func() {
			var record domain.Thing

			BeforeEach(func() {
				record = factories.Thing(GinkgoT(), store)
			})

			It("includes the saved thing", func() {
				all, err := store.ListThings(GinkgoT().Context(), 10)
				Expect(err).NotTo(HaveOccurred())
				Expect(all).To(HaveLen(1))
				Expect(all[0].ID).To(Equal(record.ID))
			})
		})
	})

	Describe("UpdateThing", func() {
		Context("with a saved thing", func() {
			var record domain.Thing

			BeforeEach(func() {
				record = factories.Thing(GinkgoT(), store)
			})

			It("stores the change", func() {
				record.Name = "Edited"
				updated, err := store.UpdateThing(GinkgoT().Context(), record)
				Expect(err).NotTo(HaveOccurred())
				Expect(updated.ID).To(Equal(record.ID))
				Expect(updated.Name).To(BeEquivalentTo("Edited"))
			})
		})

		Context("when the thing is not there", func() {
			var missing domain.Thing

			BeforeEach(func() {
				missing = factories.NewThing()
				missing.ID = 999999999
			})

			It("is not found", func() {
				_, err := store.UpdateThing(GinkgoT().Context(), missing)
				Expect(err).To(MatchError(domain.ErrNotFound))
			})
		})
	})

	Describe("DeleteThing", func() {
		DescribeTable("is not found for",
			func(id string) {
				Expect(store.DeleteThing(GinkgoT().Context(), id)).To(MatchError(domain.ErrNotFound))
			},
			Entry("a malformed id", "nope"),
			Entry("an empty id", ""),
			Entry("a well-formed id that names nothing", "999999999"),
		)

		Context("with a saved thing", func() {
			var record domain.Thing

			BeforeEach(func() {
				record = factories.Thing(GinkgoT(), store)
			})

			It("removes the thing", func() {
				id := strconv.FormatInt(record.ID, 10)
				Expect(store.DeleteThing(GinkgoT().Context(), id)).To(Succeed())
				_, err := store.GetThing(GinkgoT().Context(), id)
				Expect(err).To(MatchError(domain.ErrNotFound))
			})
		})
	})
})
==> test/factories/things.go
package factories

import (
	"context"

	"example.com/blog/app/domain"
	"example.com/blog/app/models"
)

// NewThing is a valid thing that is not saved: every attribute has a default,
// and "with" overrides what the spec cares about.
//
// Written once by `bogie g model` and yours to edit: add an attribute's
// default here when you add the column. Running the generator again leaves a
// changed file alone unless --force.
func NewThing(with ...func(*domain.Thing)) domain.Thing {
	record := domain.Thing{
		Name: Sequence("name "),
	}
	for _, f := range with {
		f(&record)
	}
	return record
}

// Thing saves a NewThing through the real store and fails the spec if it
// cannot, so a spec reads as its arrangement and nothing else.
func Thing(t T, s *models.Store, with ...func(*domain.Thing)) domain.Thing {
	t.Helper()
	created, err := s.CreateThing(context.Background(), NewThing(with...))
	if err != nil {
		t.Fatal(err)
	}
	return created
}
