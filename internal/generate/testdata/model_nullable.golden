package adapter_test

import (
	"strconv"

	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"

	"example.com/blog/app/models"
	"example.com/blog/test/factories"
)

var _ = Describe("Articles", func() {
	Describe("GetArticle", func() {
		DescribeTable("returns ErrNotFound",
			func(id string) {
				_, err := store.GetArticle(GinkgoT().Context(), id)
				Expect(err).To(MatchError(models.ErrNotFound))
			},
			Entry("when the id is not a number", "nope"),
			Entry("when the id is empty", ""),
			Entry("when no article has that id", "999999999"),
		)

		Context("with a saved article", func() {
			var record models.Article

			BeforeEach(func() {
				record = factories.Article(GinkgoT(), store)
			})

			It("finds the article by id", func() {
				Expect(store.GetArticle(GinkgoT().Context(), strconv.FormatInt(record.ID, 10))).To(Equal(record))
			})
		})
	})

	Describe("ListArticles", func() {
		Context("with a saved article", func() {
			var record models.Article

			BeforeEach(func() {
				record = factories.Article(GinkgoT(), store)
			})

			It("includes the saved article", func() {
				all, err := store.ListArticles(GinkgoT().Context(), 10)
				Expect(err).NotTo(HaveOccurred())
				Expect(all).To(HaveLen(1))
				Expect(all[0].ID).To(Equal(record.ID))
			})
		})
	})

	Describe("UpdateArticle", func() {
		Context("with a saved article", func() {
			var record models.Article

			BeforeEach(func() {
				record = factories.Article(GinkgoT(), store)
			})

			It("stores the change", func() {
				record.Title = "Edited"
				updated, err := store.UpdateArticle(GinkgoT().Context(), record)
				Expect(err).NotTo(HaveOccurred())
				Expect(updated.ID).To(Equal(record.ID))
				Expect(updated.Title).To(BeEquivalentTo("Edited"))
			})
		})

		Context("when the article is not there", func() {
			var missing models.Article

			BeforeEach(func() {
				missing = factories.NewArticle()
				missing.ID = 999999999
			})

			It("is not found", func() {
				_, err := store.UpdateArticle(GinkgoT().Context(), missing)
				Expect(err).To(MatchError(models.ErrNotFound))
			})
		})
	})

	Describe("DeleteArticle", func() {
		DescribeTable("returns ErrNotFound",
			func(id string) {
				Expect(store.DeleteArticle(GinkgoT().Context(), id)).To(MatchError(models.ErrNotFound))
			},
			Entry("when the id is not a number", "nope"),
			Entry("when the id is empty", ""),
			Entry("when no article has that id", "999999999"),
		)

		Context("with a saved article", func() {
			var record models.Article

			BeforeEach(func() {
				record = factories.Article(GinkgoT(), store)
			})

			It("removes the article", func() {
				id := strconv.FormatInt(record.ID, 10)
				Expect(store.DeleteArticle(GinkgoT().Context(), id)).To(Succeed())
				_, err := store.GetArticle(GinkgoT().Context(), id)
				Expect(err).To(MatchError(models.ErrNotFound))
			})
		})
	})
})
==> test/factories/articles.go
package factories

import (
	"context"
	"time"

	"example.com/blog/app/models"
	"example.com/blog/db/adapter"
)

// NewArticle is a valid article that is not saved: every attribute has a default,
// and "with" overrides what the spec cares about.
//
// Written once by `bogie g model` and yours to edit: add an attribute's
// default here when you add the column. Running the generator again leaves a
// changed file alone unless --force.
//
// Placeholders: the datetime defaults (EditedAt) are one fixed instant. Set real
// times where a spec depends on them, such as a window that starts before it ends.
func NewArticle(with ...func(*models.Article)) models.Article {
	record := models.Article{
		Title:    Sequence("title "),
		EditedAt: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC),
	}
	for _, f := range with {
		f(&record)
	}
	return record
}

// Article saves a NewArticle through the real store and fails the spec if it
// cannot, so a spec reads as its arrangement and nothing else.
func Article(t T, s *adapter.Store, with ...func(*models.Article)) models.Article {
	t.Helper()
	created, err := s.CreateArticle(context.Background(), NewArticle(with...))
	if err != nil {
		t.Fatal(err)
	}
	return created
}
==> db/adapter/nullable.go
package adapter

import (
	"time"

	"github.com/jackc/pgx/v5/pgtype"
)

// A nullable datetime column is a pgtype.Timestamptz in the row sqlc
// generates and a *time.Time in the model: nil is NULL. These convert between
// the two.

func timestamptzToTimePtr(t pgtype.Timestamptz) *time.Time {
	if !t.Valid {
		return nil
	}
	return &t.Time
}

func timePtrToTimestamptz(t *time.Time) pgtype.Timestamptz {
	if t == nil {
		return pgtype.Timestamptz{}
	}
	return pgtype.Timestamptz{Time: *t, Valid: true}
}
