==> db/adapter/articles.go
package adapter

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"github.com/jackc/pgx/v5/pgtype"

	"example.com/blog/app/models"
	"example.com/blog/db/sqlc"
)

// Articles, as the models see them. Each method converts models.Article to and from
// the row type sqlc generated, and maps pgx's "no rows" to models.ErrNotFound
// so callers never import pgx to ask a question.
//
// Written by `bogie g model`: overwritten whole on the next run. A
// hand-written addition goes in articles_extra.go, not here.

// CreateArticle validates an article, inserts it, and returns it with its id and
// timestamps. Validation runs on save, so every caller
// gets it and none can forget it.
func (s *Store) CreateArticle(ctx context.Context, a models.Article) (models.Article, error) {
	if err := a.Validate(); err != nil {
		return models.Article{}, err
	}
	row, err := s.q.CreateArticle(ctx, sqlc.CreateArticleParams{Title: a.Title, Subtitle: a.Subtitle, Views: a.Views, PublishedAt: timePtrToTimestamptz(a.PublishedAt), EditedAt: pgtype.Timestamptz{Time: a.EditedAt, Valid: true}})
	if err != nil {
		return models.Article{}, fmt.Errorf("store: create article: %w", err)
	}
	return articleFromRow(row), nil
}

// GetArticle finds one article. An id that is not a valid id is simply not found.
func (s *Store) GetArticle(ctx context.Context, id string) (models.Article, error) {
	pk, err := parseID(id)
	if err != nil {
		return models.Article{}, models.ErrNotFound
	}
	row, err := s.q.GetArticle(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return models.Article{}, models.ErrNotFound
	case err != nil:
		return models.Article{}, fmt.Errorf("store: get article %s: %w", id, err)
	}
	return articleFromRow(row), nil
}

// ListArticles returns the newest articles first, at most limit of them.
func (s *Store) ListArticles(ctx context.Context, limit int32) ([]models.Article, error) {
	rows, err := s.q.ListArticles(ctx, limit)
	if err != nil {
		return nil, fmt.Errorf("store: list articles: %w", err)
	}
	out := make([]models.Article, 0, len(rows))
	for _, r := range rows {
		out = append(out, articleFromRow(r))
	}
	return out, nil
}

// UpdateArticle validates an article, writes its columns, and returns the stored row.
func (s *Store) UpdateArticle(ctx context.Context, a models.Article) (models.Article, error) {
	if err := a.Validate(); err != nil {
		return models.Article{}, err
	}
	pk := a.ID
	row, err := s.q.UpdateArticle(ctx, sqlc.UpdateArticleParams{ID: pk, Title: a.Title, Subtitle: a.Subtitle, Views: a.Views, PublishedAt: timePtrToTimestamptz(a.PublishedAt), EditedAt: pgtype.Timestamptz{Time: a.EditedAt, Valid: true}})
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return models.Article{}, models.ErrNotFound
	case err != nil:
		return models.Article{}, fmt.Errorf("store: update article %v: %w", a.ID, err)
	}
	return articleFromRow(row), nil
}

// DeleteArticle removes an article, and says so if there was none.
func (s *Store) DeleteArticle(ctx context.Context, id string) error {
	pk, err := parseID(id)
	if err != nil {
		return models.ErrNotFound
	}
	n, err := s.q.DeleteArticle(ctx, pk)
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return fmt.Errorf("%w: article is still in use", models.ErrInvalid)
		}
		return fmt.Errorf("store: delete article %s: %w", id, err)
	}
	if n == 0 {
		return models.ErrNotFound
	}
	return nil
}

func articleFromRow(r sqlc.Article) models.Article {
	return models.Article{
		ID:          r.ID,
		Title:       r.Title,
		Subtitle:    r.Subtitle,
		Views:       r.Views,
		PublishedAt: timestamptzToTimePtr(r.PublishedAt),
		EditedAt:    r.EditedAt.Time,
		CreatedAt:   r.CreatedAt.Time,
		UpdatedAt:   r.UpdatedAt.Time,
	}
}
