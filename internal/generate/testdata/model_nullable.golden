package models

import (
	"time"
)

// Article is an article. Imports nothing third-party: ids are int64s here and
// become bigint at the store boundary.
type Article struct {
	ID          int64
	Title       string
	Subtitle    *string
	Views       *int32
	PublishedAt *time.Time
	EditedAt    time.Time
	CreatedAt   time.Time
	UpdatedAt   time.Time
}

// Validate is the model's validations. Wrap every
// failure in ErrInvalid so a controller can answer 422 without knowing the
// rule:
//
//	return fmt.Errorf("%w: title is required", ErrInvalid)
func (a Article) Validate() error {
	return nil
}
