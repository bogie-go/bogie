==> db/adapter/posts.go
package adapter

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"github.com/jackc/pgx/v5/pgtype"

	"example.com/blog/app/models"
	"example.com/blog/db/sqlc"
)

// Posts, as the models see them. Each method converts models.Post to and from
// the row type sqlc generated, and maps pgx's "no rows" to models.ErrNotFound
// so callers never import pgx to ask a question.
//
// Written by `bogie g model`: overwritten whole on the next run. A
// hand-written addition goes in posts_extra.go, not here.

// CreatePost validates a post, inserts it, and returns it with its id and
// timestamps. Validation runs on save, so every caller
// gets it and none can forget it.
func (s *Store) CreatePost(ctx context.Context, p models.Post) (models.Post, error) {
	if err := p.Validate(); err != nil {
		return models.Post{}, err
	}
	row, err := s.q.CreatePost(ctx, sqlc.CreatePostParams{Title: p.Title, Body: p.Body, Score: p.Score, PublishedAt: pgtype.Timestamptz{Time: p.PublishedAt, Valid: true}, AuthorID: p.AuthorID})
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return models.Post{}, fmt.Errorf("%w: author_id does not exist", models.ErrInvalid)
		}
		return models.Post{}, fmt.Errorf("store: create post: %w", err)
	}
	return postFromRow(row), nil
}

// GetPost finds one post. An id that is not a valid id is simply not found.
func (s *Store) GetPost(ctx context.Context, id string) (models.Post, error) {
	pk, err := parseID(id)
	if err != nil {
		return models.Post{}, models.ErrNotFound
	}
	row, err := s.q.GetPost(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return models.Post{}, models.ErrNotFound
	case err != nil:
		return models.Post{}, fmt.Errorf("store: get post %s: %w", id, err)
	}
	return postFromRow(row), nil
}

// ListPosts returns the newest posts first, at most limit of them.
func (s *Store) ListPosts(ctx context.Context, limit int32) ([]models.Post, error) {
	rows, err := s.q.ListPosts(ctx, limit)
	if err != nil {
		return nil, fmt.Errorf("store: list posts: %w", err)
	}
	out := make([]models.Post, 0, len(rows))
	for _, r := range rows {
		out = append(out, postFromRow(r))
	}
	return out, nil
}

// UpdatePost validates a post, writes its columns, and returns the stored row.
func (s *Store) UpdatePost(ctx context.Context, p models.Post) (models.Post, error) {
	if err := p.Validate(); err != nil {
		return models.Post{}, err
	}
	pk := p.ID
	row, err := s.q.UpdatePost(ctx, sqlc.UpdatePostParams{ID: pk, Title: p.Title, Body: p.Body, Score: p.Score, PublishedAt: pgtype.Timestamptz{Time: p.PublishedAt, Valid: true}, AuthorID: p.AuthorID})
	var pgErr *pgconn.PgError
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return models.Post{}, models.ErrNotFound
	case errors.As(err, &pgErr) && pgErr.Code == "23503":
		return models.Post{}, fmt.Errorf("%w: author_id does not exist", models.ErrInvalid)
	case err != nil:
		return models.Post{}, fmt.Errorf("store: update post %v: %w", p.ID, err)
	}
	return postFromRow(row), nil
}

// DeletePost removes a post, and says so if there was none.
func (s *Store) DeletePost(ctx context.Context, id string) error {
	pk, err := parseID(id)
	if err != nil {
		return models.ErrNotFound
	}
	n, err := s.q.DeletePost(ctx, pk)
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return fmt.Errorf("%w: post is still in use", models.ErrInvalid)
		}
		return fmt.Errorf("store: delete post %s: %w", id, err)
	}
	if n == 0 {
		return models.ErrNotFound
	}
	return nil
}

func postFromRow(r sqlc.Post) models.Post {
	return models.Post{
		ID:          r.ID,
		Title:       r.Title,
		Body:        r.Body,
		Score:       r.Score,
		PublishedAt: r.PublishedAt.Time,
		AuthorID:    r.AuthorID,
		CreatedAt:   r.CreatedAt.Time,
		UpdatedAt:   r.UpdatedAt.Time,
	}
}
