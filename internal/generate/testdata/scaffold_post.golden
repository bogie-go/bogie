package models

import (
	"context"
	"errors"
	"testing"

	"example.com/blog/app/domain"
)

// Whatever the id looks like, a post that is not there is ErrNotFound, and a
// caller cannot tell a malformed id from a well-formed one that names nothing.
func TestUnknownPostsAreNotFound(t *testing.T) {
	store := testStore(t)
	ctx := context.Background()

	for _, id := range []string{"nope", "", "00000000-0000-4000-8000-000000000000"} {
		if _, err := store.GetPost(ctx, id); !errors.Is(err, domain.ErrNotFound) {
			t.Errorf("GetPost(%q): err = %v, want ErrNotFound", id, err)
		}
		if err := store.DeletePost(ctx, id); !errors.Is(err, domain.ErrNotFound) {
			t.Errorf("DeletePost(%q): err = %v, want ErrNotFound", id, err)
		}
		if _, err := store.UpdatePost(ctx, domain.Post{ID: id, AuthorID: "00000000-0000-4000-8000-000000000000"}); !errors.Is(err, domain.ErrNotFound) {
			t.Errorf("UpdatePost(%q): err = %v, want ErrNotFound", id, err)
		}
	}
}

