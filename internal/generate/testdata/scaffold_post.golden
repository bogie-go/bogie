package domain

import (
	"time"
)

// Post is a post. Imports nothing third-party: ids are strings here and
// become uuid at the store boundary.
type Post struct {
	ID          string
	Title       string
	Body        string
	Score       int32
	PublishedAt time.Time
	AuthorID    string
	CreatedAt   time.Time
	UpdatedAt   time.Time
}

// Validate is the model's validations, as Rails would put them. Wrap every
// failure in ErrInvalid so a controller can answer 422 without knowing the
// rule:
//
//	return fmt.Errorf("%w: title is required", ErrInvalid)
func (p Post) Validate() error {
	return nil
}
==> app/models/posts.go
package models

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgtype"

	"example.com/blog/app/domain"
)

// Posts, as the domain sees them. Each method converts domain.Post to and from
// the row type sqlc generated, and maps pgx's "no rows" to domain.ErrNotFound
// so callers never import pgx to ask a question.

// CreatePost validates a post, inserts it, and returns it with its id and
// timestamps. Validation runs on save, as Rails's does, so every caller
// gets it and none can forget it.
func (s *Store) CreatePost(ctx context.Context, p domain.Post) (domain.Post, error) {
	if err := p.Validate(); err != nil {
		return domain.Post{}, err
	}
	authorID, err := parseUUID(p.AuthorID)
	if err != nil {
		return domain.Post{}, fmt.Errorf("%w: author_id is not a uuid", domain.ErrInvalid)
	}
	row, err := s.q.CreatePost(ctx, CreatePostParams{Title: p.Title, Body: p.Body, Score: p.Score, PublishedAt: pgtype.Timestamptz{Time: p.PublishedAt, Valid: true}, AuthorID: authorID})
	if err != nil {
		return domain.Post{}, fmt.Errorf("models: create post: %w", err)
	}
	return postFromRow(row), nil
}

// GetPost finds one post. An id that is not a uuid is simply not found.
func (s *Store) GetPost(ctx context.Context, id string) (domain.Post, error) {
	uid, err := parseUUID(id)
	if err != nil {
		return domain.Post{}, domain.ErrNotFound
	}
	row, err := s.q.GetPost(ctx, uid)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.Post{}, domain.ErrNotFound
	case err != nil:
		return domain.Post{}, fmt.Errorf("models: get post %s: %w", id, err)
	}
	return postFromRow(row), nil
}

// ListPosts returns the newest posts first, at most limit of them.
func (s *Store) ListPosts(ctx context.Context, limit int32) ([]domain.Post, error) {
	rows, err := s.q.ListPosts(ctx, limit)
	if err != nil {
		return nil, fmt.Errorf("models: list posts: %w", err)
	}
	out := make([]domain.Post, 0, len(rows))
	for _, r := range rows {
		out = append(out, postFromRow(r))
	}
	return out, nil
}

// UpdatePost validates a post, writes its columns, and returns the stored row.
func (s *Store) UpdatePost(ctx context.Context, p domain.Post) (domain.Post, error) {
	if err := p.Validate(); err != nil {
		return domain.Post{}, err
	}
	uid, err := parseUUID(p.ID)
	if err != nil {
		return domain.Post{}, domain.ErrNotFound
	}
	authorID, err := parseUUID(p.AuthorID)
	if err != nil {
		return domain.Post{}, fmt.Errorf("%w: author_id is not a uuid", domain.ErrInvalid)
	}
	row, err := s.q.UpdatePost(ctx, UpdatePostParams{ID: uid, Title: p.Title, Body: p.Body, Score: p.Score, PublishedAt: pgtype.Timestamptz{Time: p.PublishedAt, Valid: true}, AuthorID: authorID})
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.Post{}, domain.ErrNotFound
	case err != nil:
		return domain.Post{}, fmt.Errorf("models: update post %s: %w", p.ID, err)
	}
	return postFromRow(row), nil
}

// DeletePost removes a post, and says so if there was none.
func (s *Store) DeletePost(ctx context.Context, id string) error {
	uid, err := parseUUID(id)
	if err != nil {
		return domain.ErrNotFound
	}
	n, err := s.q.DeletePost(ctx, uid)
	if err != nil {
		return fmt.Errorf("models: delete post %s: %w", id, err)
	}
	if n == 0 {
		return domain.ErrNotFound
	}
	return nil
}

func postFromRow(r Post) domain.Post {
	return domain.Post{
		ID:          uuidString(r.ID),
		Title:       r.Title,
		Body:        r.Body,
		Score:       r.Score,
		PublishedAt: r.PublishedAt.Time,
		AuthorID:    uuidString(r.AuthorID),
		CreatedAt:   r.CreatedAt.Time,
		UpdatedAt:   r.UpdatedAt.Time,
	}
}
