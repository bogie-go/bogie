==> test/factories/posts.go
package factories

import (
	"context"
	"time"

	"example.com/blog/app/models"
	"example.com/blog/db/adapter"
)

// NewPost is a valid post that is not saved: every attribute has a default,
// and "with" overrides what the spec cares about.
//
// Written once by `bogie g model` and yours to edit: add an attribute's
// default here when you add the column. Running the generator again leaves a
// changed file alone unless --force.
//
// Left at zero: AuthorID. The parent has to exist first, so set it from the
// parent's own factory:
//
//	factories.Post(t, s, func(v *models.Post) { v.AuthorID = parent.ID })
//
// Placeholders: the datetime defaults (PublishedAt) are one fixed instant. Set real
// times where a spec depends on them, such as a window that starts before it ends.
func NewPost(with ...func(*models.Post)) models.Post {
	record := models.Post{
		Title:       Sequence("title "),
		Body:        Sequence("body "),
		Score:       1,
		PublishedAt: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC),
	}
	for _, f := range with {
		f(&record)
	}
	return record
}

// Post saves a NewPost through the real store and fails the spec if it
// cannot, so a spec reads as its arrangement and nothing else.
func Post(t T, s *adapter.Store, with ...func(*models.Post)) models.Post {
	t.Helper()
	created, err := s.CreatePost(context.Background(), NewPost(with...))
	if err != nil {
		t.Fatal(err)
	}
	return created
}
