==> app/views/posts.go
package views

import (
	"time"
)

// PostRequest is the body of POST /posts and PATCH /posts/:id.
type PostRequest struct {
	Title       string    `json:"title"`
	Body        string    `json:"body"`
	Score       int32     `json:"score"`
	PublishedAt time.Time `json:"published_at"`
	AuthorID    string    `json:"author_id"`
}

// PostResponse is one post on the wire.
type PostResponse struct {
	ID          string    `json:"id"`
	Title       string    `json:"title"`
	Body        string    `json:"body"`
	Score       int32     `json:"score"`
	PublishedAt time.Time `json:"published_at"`
	AuthorID    string    `json:"author_id"`
	CreatedAt   time.Time `json:"created_at"`
	UpdatedAt   time.Time `json:"updated_at"`
}

// PostsResponse is a listing.
type PostsResponse struct {
	Posts []PostResponse `json:"posts"`
}
==> app/controllers/posts_controller.go
package controllers

import (
	"context"
	"errors"
	"log/slog"
	"net/http"

	"github.com/gin-gonic/gin"

	"example.com/blog/app/domain"
	"example.com/blog/app/views"
)

// postsStore is the slice of the store this controller uses, declared next to
// its caller (rule 2) and holding only the methods the actions call.
// *models.Store satisfies it, and app/application.go passes it in; the
// test's fake is a few lines.
type postsStore interface {
	CreatePost(ctx context.Context, p domain.Post) (domain.Post, error)
	GetPost(ctx context.Context, id string) (domain.Post, error)
	ListPosts(ctx context.Context, limit int32) ([]domain.Post, error)
	UpdatePost(ctx context.Context, p domain.Post) (domain.Post, error)
	DeletePost(ctx context.Context, id string) error
}

// postsListLimit is how many a listing returns, newest first. Paging is
// yours to add when a client needs more.
const postsListLimit = 100

// PostsController is the HTTP surface of posts: a JSON resource over the store. A
// handler converts HTTP into domain values, calls one store method, and
// converts the result back. Validation is the domain's and runs on save,
// which is why a bad value is a 422 from the store and not a binding rule
// here. Nothing below app/controllers sees *gin.Context (rule 5).
type PostsController struct {
	Store postsStore
	Log   *slog.Logger
}

// NewPostsController builds the controller.
func NewPostsController(store postsStore, log *slog.Logger) *PostsController {
	return &PostsController{Store: store, Log: log}
}

// SetupRoutes mounts the resource under its own prefix. Middleware the whole
// controller needs goes here; which group it sits in, and so how it is
// exposed, is decided by routes.go, which calls this.
func (ctl *PostsController) SetupRoutes(router *gin.RouterGroup) {
	posts := router.Group("/posts")
	posts.GET("", ctl.Index)
	posts.POST("", ctl.Create)
	posts.GET("/:id", ctl.Show)
	posts.PATCH("/:id", ctl.Update)
	posts.DELETE("/:id", ctl.Destroy)
}

// Index handles GET /posts.
func (ctl *PostsController) Index(c *gin.Context) {
	posts, err := ctl.Store.ListPosts(c.Request.Context(), postsListLimit)
	if err != nil {
		ctl.fail(c, err)
		return
	}
	c.JSON(http.StatusOK, postsView(posts))
}

// Show handles GET /posts/:id.
func (ctl *PostsController) Show(c *gin.Context) {
	p, err := ctl.Store.GetPost(c.Request.Context(), c.Param("id"))
	if err != nil {
		ctl.fail(c, err)
		return
	}
	c.JSON(http.StatusOK, postView(p))
}

// Create handles POST /posts.
func (ctl *PostsController) Create(c *gin.Context) {
	var req views.PostRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, views.Error(err))
		return
	}
	p, err := ctl.Store.CreatePost(c.Request.Context(), domain.Post{Title: req.Title, Body: req.Body, Score: req.Score, PublishedAt: req.PublishedAt, AuthorID: req.AuthorID})
	if err != nil {
		ctl.fail(c, err)
		return
	}
	c.JSON(http.StatusCreated, postView(p))
}

// Update handles PATCH /posts/:id. Only the fields in the body change, as
// in Rails: the post is loaded, the body is decoded over its current values,
// so a key left out keeps its value, and the result is saved and validated
// whole.
func (ctl *PostsController) Update(c *gin.Context) {
	p, err := ctl.Store.GetPost(c.Request.Context(), c.Param("id"))
	if err != nil {
		ctl.fail(c, err)
		return
	}
	req := views.PostRequest{Title: p.Title, Body: p.Body, Score: p.Score, PublishedAt: p.PublishedAt, AuthorID: p.AuthorID}
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, views.Error(err))
		return
	}
	p, err = ctl.Store.UpdatePost(c.Request.Context(), domain.Post{ID: c.Param("id"), Title: req.Title, Body: req.Body, Score: req.Score, PublishedAt: req.PublishedAt, AuthorID: req.AuthorID})
	if err != nil {
		ctl.fail(c, err)
		return
	}
	c.JSON(http.StatusOK, postView(p))
}

// Destroy handles DELETE /posts/:id.
func (ctl *PostsController) Destroy(c *gin.Context) {
	if err := ctl.Store.DeletePost(c.Request.Context(), c.Param("id")); err != nil {
		ctl.fail(c, err)
		return
	}
	c.Status(http.StatusNoContent)
}

// fail maps a domain error to a status, the one place that mapping lives:
// not found is 404, a validation failure is 422 as in Rails, and anything
// else is logged and answered 500 without leaking its text.
func (ctl *PostsController) fail(c *gin.Context, err error) {
	switch {
	case errors.Is(err, domain.ErrNotFound):
		c.JSON(http.StatusNotFound, views.ErrorMessage("no such post"))
	case errors.Is(err, domain.ErrInvalid):
		c.JSON(http.StatusUnprocessableEntity, views.Error(err))
	default:
		ctl.Log.ErrorContext(c.Request.Context(), "posts: request failed",
			"path", c.FullPath(), "err", err, "request_id", c.GetString("request_id"))
		c.JSON(http.StatusInternalServerError, views.ErrorMessage("internal error"))
	}
}

// The controller converts between the domain and the wire. views never
// imports domain, so this is where PostResponse is built.

func postView(p domain.Post) views.PostResponse {
	return views.PostResponse{
		ID:          p.ID,
		Title:       p.Title,
		Body:        p.Body,
		Score:       p.Score,
		PublishedAt: p.PublishedAt,
		AuthorID:    p.AuthorID,
		CreatedAt:   p.CreatedAt,
		UpdatedAt:   p.UpdatedAt,
	}
}

func postsView(posts []domain.Post) views.PostsResponse {
	out := views.PostsResponse{Posts: make([]views.PostResponse, 0, len(posts))}
	for _, p := range posts {
		out.Posts = append(out.Posts, postView(p))
	}
	return out
}
==> app/controllers/posts_controller_test.go
package controllers

import (
	"context"
	"encoding/json"
	"errors"
	"io"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/gin-gonic/gin"

	"example.com/blog/app/domain"
)

// fakePostsStore is a fake of the store interface declared beside the controller: it
// records what the controller asked for and answers with what the test chose.
type fakePostsStore struct {
	one  domain.Post
	many []domain.Post
	err  error

	gotID string
	got   domain.Post
}

func (f *fakePostsStore) CreatePost(_ context.Context, p domain.Post) (domain.Post, error) {
	f.got = p
	return f.one, f.err
}

func (f *fakePostsStore) GetPost(_ context.Context, id string) (domain.Post, error) {
	f.gotID = id
	return f.one, f.err
}

func (f *fakePostsStore) ListPosts(context.Context, int32) ([]domain.Post, error) {
	return f.many, f.err
}

func (f *fakePostsStore) UpdatePost(_ context.Context, p domain.Post) (domain.Post, error) {
	f.gotID, f.got = p.ID, p
	return f.one, f.err
}

func (f *fakePostsStore) DeletePost(_ context.Context, id string) error {
	f.gotID = id
	return f.err
}

// postsRequest mounts the controller alone on a bare router, so these tests see
// the controller and nothing else: no middleware, no other routes.
func postsRequest(t *testing.T, store *fakePostsStore, method, path, body string) *httptest.ResponseRecorder {
	t.Helper()
	gin.SetMode(gin.TestMode)
	router := gin.New()
	NewPostsController(store, slog.New(slog.NewTextHandler(io.Discard, nil))).SetupRoutes(&router.RouterGroup)

	rec := httptest.NewRecorder()
	req := httptest.NewRequest(method, path, strings.NewReader(body))
	req.Header.Set("Content-Type", "application/json")
	router.ServeHTTP(rec, req)
	return rec
}

func TestPostsIndexLists(t *testing.T) {
	store := &fakePostsStore{many: []domain.Post{{ID: "a"}, {ID: "b"}}}
	rec := postsRequest(t, store, http.MethodGet, "/posts", "")

	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d: %s", rec.Code, rec.Body)
	}
	var body struct {
		Posts []struct{ ID string } `json:"posts"`
	}
	if err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {
		t.Fatal(err)
	}
	if len(body.Posts) != 2 || body.Posts[1].ID != "b" {
		t.Errorf("body = %+v", body)
	}
}

func TestPostsShowUnknownIs404(t *testing.T) {
	rec := postsRequest(t, &fakePostsStore{err: domain.ErrNotFound}, http.MethodGet, "/posts/nope", "")
	if rec.Code != http.StatusNotFound {
		t.Errorf("status = %d, want 404", rec.Code)
	}
}

func TestPostsCreatePassesTheBodyThroughAndAnswers201(t *testing.T) {
	store := &fakePostsStore{one: domain.Post{ID: "a"}}
	rec := postsRequest(t, store, http.MethodPost, "/posts", `{"title":"Hello","body":"Hello","score":7,"published_at":"2026-10-02T09:30:00Z","author_id":"00000000-0000-4000-8000-000000000000"}`)

	if rec.Code != http.StatusCreated {
		t.Fatalf("status = %d: %s", rec.Code, rec.Body)
	}
	if store.got.Title != "Hello" {
		t.Errorf("store got Title = %v", store.got.Title)
	}
	if !strings.Contains(rec.Body.String(), `"id":"a"`) {
		t.Errorf("body = %s", rec.Body)
	}
}

// Validation is the domain's and runs in the store. The controller's only
// job is to say 422.
func TestPostsCreateInvalidIs422(t *testing.T) {
	store := &fakePostsStore{err: errors.Join(domain.ErrInvalid, errors.New("not valid"))}
	rec := postsRequest(t, store, http.MethodPost, "/posts", `{"title":"Hello","body":"Hello","score":7,"published_at":"2026-10-02T09:30:00Z","author_id":"00000000-0000-4000-8000-000000000000"}`)
	if rec.Code != http.StatusUnprocessableEntity {
		t.Errorf("status = %d, want 422: %s", rec.Code, rec.Body)
	}
}

func TestPostsCreateMalformedJSONIs400(t *testing.T) {
	rec := postsRequest(t, &fakePostsStore{}, http.MethodPost, "/posts", `{"nope":`)
	if rec.Code != http.StatusBadRequest {
		t.Errorf("status = %d, want 400", rec.Code)
	}
}

// PATCH is partial, as in Rails: a field the body leaves out keeps its
// stored value rather than being blanked.
func TestPostsUpdateChangesOnlyTheFieldsSent(t *testing.T) {
	store := &fakePostsStore{one: domain.Post{ID: "a", Title: "Hello", Body: "Hello", Score: 7, AuthorID: "00000000-0000-4000-8000-000000000000"}}
	rec := postsRequest(t, store, http.MethodPatch, "/posts/a", `{"title":"Edited"}`)

	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d: %s", rec.Code, rec.Body)
	}
	if store.got.Title != "Edited" {
		t.Errorf("store got Title = %v, want %v", store.got.Title, "Edited")
	}
	if store.got.Body != "Hello" {
		t.Errorf("store got Body = %v, want it kept", store.got.Body)
	}
	if store.got.Score != 7 {
		t.Errorf("store got Score = %v, want it kept", store.got.Score)
	}
	if store.got.AuthorID != "00000000-0000-4000-8000-000000000000" {
		t.Errorf("store got AuthorID = %v, want it kept", store.got.AuthorID)
	}
}

func TestPostsUpdateUnknownIs404(t *testing.T) {
	rec := postsRequest(t, &fakePostsStore{err: domain.ErrNotFound}, http.MethodPatch, "/posts/nope", `{}`)
	if rec.Code != http.StatusNotFound {
		t.Errorf("status = %d, want 404", rec.Code)
	}
}

func TestPostsDestroyAnswers204(t *testing.T) {
	store := &fakePostsStore{}
	rec := postsRequest(t, store, http.MethodDelete, "/posts/a", "")
	if rec.Code != http.StatusNoContent || store.gotID != "a" {
		t.Errorf("status = %d, id = %q", rec.Code, store.gotID)
	}
}

// An unexpected error is a 500 that says nothing about its cause.
func TestPostsUnexpectedErrorIs500WithoutDetail(t *testing.T) {
	rec := postsRequest(t, &fakePostsStore{err: errors.New("connection refused to db-1")}, http.MethodGet, "/posts", "")
	if rec.Code != http.StatusInternalServerError {
		t.Errorf("status = %d, want 500", rec.Code)
	}
	if strings.Contains(rec.Body.String(), "db-1") {
		t.Errorf("body leaks the internal error: %s", rec.Body)
	}
}
