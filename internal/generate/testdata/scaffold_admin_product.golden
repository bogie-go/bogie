import (
	"time"
)

// AdminProduct is an admin_product. Imports nothing third-party: ids are int64s here and
// become bigint at the store boundary.
type AdminProduct struct {
	ID        int64
	Name      string
	CreatedAt time.Time
	UpdatedAt time.Time
}

// Validate is the model's validations. Wrap every
// failure in ErrInvalid so a controller can answer 422 without knowing the
// rule:
//
//	return fmt.Errorf("%w: title is required", ErrInvalid)
func (a AdminProduct) Validate() error {
	return nil
}
