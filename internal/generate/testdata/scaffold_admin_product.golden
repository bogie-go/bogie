var _ = Describe("AdminProducts", func() {
	Describe("GetAdminProduct", func() {
		DescribeTable("returns ErrNotFound",
			func(id string) {
				_, err := store.GetAdminProduct(GinkgoT().Context(), id)
				Expect(err).To(MatchError(models.ErrNotFound))
			},
			Entry("when the id is not a number", "nope"),
			Entry("when the id is empty", ""),
			Entry("when no admin product has that id", "999999999"),
		)

		Context("with a saved admin product", func() {
			var record models.AdminProduct

			BeforeEach(func() {
				record = factories.AdminProduct(GinkgoT(), store)
			})

			It("finds the admin product by id", func() {
				Expect(store.GetAdminProduct(GinkgoT().Context(), strconv.FormatInt(record.ID, 10))).To(Equal(record))
			})
		})
	})

	Describe("ListAdminProducts", func() {
		Context("with a saved admin product", func() {
			var record models.AdminProduct

			BeforeEach(func() {
				record = factories.AdminProduct(GinkgoT(), store)
			})

			It("includes the saved admin product", func() {
				all, err := store.ListAdminProducts(GinkgoT().Context(), 10)
				Expect(err).NotTo(HaveOccurred())
				Expect(all).To(HaveLen(1))
				Expect(all[0].ID).To(Equal(record.ID))
			})
		})
	})

	Describe("UpdateAdminProduct", func() {
		Context("with a saved admin product", func() {
			var record models.AdminProduct

			BeforeEach(func() {
				record = factories.AdminProduct(GinkgoT(), store)
			})

			It("stores the change", func() {
				record.Name = "Edited"
				updated, err := store.UpdateAdminProduct(GinkgoT().Context(), record)
				Expect(err).NotTo(HaveOccurred())
				Expect(updated.ID).To(Equal(record.ID))
				Expect(updated.Name).To(BeEquivalentTo("Edited"))
			})
		})

		Context("when the admin product is not there", func() {
			var missing models.AdminProduct

			BeforeEach(func() {
				missing = factories.NewAdminProduct()
				missing.ID = 999999999
			})

			It("is not found", func() {
				_, err := store.UpdateAdminProduct(GinkgoT().Context(), missing)
				Expect(err).To(MatchError(models.ErrNotFound))
			})
		})
	})

	Describe("DeleteAdminProduct", func() {
		DescribeTable("returns ErrNotFound",
			func(id string) {
				Expect(store.DeleteAdminProduct(GinkgoT().Context(), id)).To(MatchError(models.ErrNotFound))
			},
			Entry("when the id is not a number", "nope"),
			Entry("when the id is empty", ""),
			Entry("when no admin product has that id", "999999999"),
		)

		Context("with a saved admin product", func() {
			var record models.AdminProduct

			BeforeEach(func() {
				record = factories.AdminProduct(GinkgoT(), store)
			})

			It("removes the admin product", func() {
				id := strconv.FormatInt(record.ID, 10)
				Expect(store.DeleteAdminProduct(GinkgoT().Context(), id)).To(Succeed())
				_, err := store.GetAdminProduct(GinkgoT().Context(), id)
				Expect(err).To(MatchError(models.ErrNotFound))
			})
		})
	})
})
