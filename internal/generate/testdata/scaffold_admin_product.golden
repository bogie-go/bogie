package admin_controllers_test

import (
	"fmt"
	"net/http"

	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"

	"example.com/blog/app/models"
	"example.com/blog/app/views"
	"example.com/blog/test/factories"
)

var _ = Describe("GET /admin/products", func() {
	Context("with no admin_products", func() {
		It("is an empty list", func() {
			app.Get("/admin/products").Do().Status(http.StatusOK).Contains("\"admin_products\":[]")
		})
	})

	Context("with admin_products", func() {
		var first, second models.AdminProduct

		BeforeEach(func() {
			first = factories.AdminProduct(GinkgoT(), app.Store)
			second = factories.AdminProduct(GinkgoT(), app.Store)
		})

		It("lists them, newest first", func() {
			var list views.AdminProductsResponse
			app.Get("/admin/products").Do().Status(http.StatusOK).JSON(&list)

			Expect(list.AdminProducts).To(HaveLen(2))
			Expect(list.AdminProducts[0].ID).To(Equal(second.ID))
			Expect(list.AdminProducts[1].ID).To(Equal(first.ID))
		})
	})
})

var _ = Describe("GET /admin/products/:id", func() {
	Context("when the admin_product exists", func() {
		var record models.AdminProduct

		BeforeEach(func() {
			record = factories.AdminProduct(GinkgoT(), app.Store)
		})

		It("shows it", func() {
			var shown views.AdminProductResponse
			app.Get("/admin/products/" + fmt.Sprint(record.ID)).Do().Status(http.StatusOK).JSON(&shown)

			Expect(shown.ID).To(Equal(record.ID))
		})
	})

	Context("when the admin_product does not exist", func() {
		It("is not found", func() {
			app.Get("/admin/products/999999999").Do().Status(http.StatusNotFound)
		})
	})
})

var _ = Describe("POST /admin/products", func() {
	var body views.AdminProductRequest

	Context("with a valid body", func() {
		BeforeEach(func() {
			body = adminProductRequest(factories.NewAdminProduct())
		})

		It("creates it", func() {
			var created views.AdminProductResponse
			app.Post("/admin/products", body).Do().Status(http.StatusCreated).JSON(&created)

			Expect(created.ID).NotTo(BeZero())
			_, err := app.Store.GetAdminProduct(GinkgoT().Context(), fmt.Sprint(created.ID))
			Expect(err).NotTo(HaveOccurred())
		})
	})

	Context("with a malformed body", func() {
		It("is a bad request", func() {
			app.Post("/admin/products", "{\"nope\":").Do().Status(http.StatusBadRequest)
		})
	})
})

var _ = Describe("PATCH /admin/products/:id", func() {
	Context("when the admin_product exists", func() {
		var record models.AdminProduct

		BeforeEach(func() {
			record = factories.AdminProduct(GinkgoT(), app.Store)
		})

		It("changes only the fields sent", func() {
			var updated views.AdminProductResponse
			app.Patch("/admin/products/"+fmt.Sprint(record.ID), map[string]any{"name": "Edited"}).Do().Status(http.StatusOK).JSON(&updated)

			Expect(updated.Name).To(BeEquivalentTo("Edited"))
		})

		Context("with a malformed body", func() {
			It("is a bad request", func() {
				app.Patch("/admin/products/"+fmt.Sprint(record.ID), "{\"nope\":").Do().Status(http.StatusBadRequest)
			})
		})
	})

	Context("when the admin_product does not exist", func() {
		It("is not found", func() {
			app.Patch("/admin/products/999999999", map[string]any{}).Do().Status(http.StatusNotFound)
		})
	})
})

var _ = Describe("DELETE /admin/products/:id", func() {
	Context("when the admin_product exists", func() {
		var record models.AdminProduct

		BeforeEach(func() {
			record = factories.AdminProduct(GinkgoT(), app.Store)
		})

		It("deletes it", func() {
			app.Delete("/admin/products/" + fmt.Sprint(record.ID)).Do().Status(http.StatusNoContent)

			app.Get("/admin/products/" + fmt.Sprint(record.ID)).Do().Status(http.StatusNotFound)
		})
	})

	Context("when the admin_product does not exist", func() {
		It("is not found", func() {
			app.Delete("/admin/products/999999999").Do().Status(http.StatusNotFound)
		})
	})
})

// adminProductRequest is the body that creates a record like this one.
func adminProductRequest(record models.AdminProduct) views.AdminProductRequest {
	return views.AdminProductRequest{Name: record.Name}
}
