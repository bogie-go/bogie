package views

import (
	"time"
)

// AdminProductRequest is the body of POST /products and PATCH /products/:id.
type AdminProductRequest struct {
	Name string `json:"name"`
}

// AdminProductResponse is one admin_product on the wire.
type AdminProductResponse struct {
	ID        int64     `json:"id"`
	Name      string    `json:"name"`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

// AdminProductsResponse is a listing.
type AdminProductsResponse struct {
	AdminProducts []AdminProductResponse `json:"admin_products"`
}
==> app/controllers/admin_controllers/products_controller.go
package admin_controllers

import (
	"context"
	"errors"
	"log/slog"
	"net/http"

	"github.com/gin-gonic/gin"

	"example.com/blog/app/models"
	"example.com/blog/app/views"
)

// adminProductsStore is the slice of the store this controller uses, declared next to
// its caller and holding only the methods the actions call.
// *adapter.Store satisfies it, and app/application.go passes it in.
type adminProductsStore interface {
	CreateAdminProduct(ctx context.Context, a models.AdminProduct) (models.AdminProduct, error)
	GetAdminProduct(ctx context.Context, id string) (models.AdminProduct, error)
	ListAdminProducts(ctx context.Context, limit int32) ([]models.AdminProduct, error)
	UpdateAdminProduct(ctx context.Context, a models.AdminProduct) (models.AdminProduct, error)
	DeleteAdminProduct(ctx context.Context, id string) error
}

// adminProductsListLimit is how many a listing returns, newest first. Paging is
// yours to add when a client needs more.
const adminProductsListLimit = 100

// ProductsController is the HTTP surface of products: a JSON resource over the store. A
// handler converts HTTP into domain values, calls one store method, and
// converts the result back. Validation is the domain's and runs on save,
// which is why a bad value is a 422 from the store and not a binding rule
// here. Nothing below app/controllers sees *gin.Context.
type ProductsController struct {
	Store adminProductsStore
	Log   *slog.Logger
}

// NewProductsController builds the controller.
func NewProductsController(store adminProductsStore, log *slog.Logger) *ProductsController {
	return &ProductsController{Store: store, Log: log}
}

// SetupRoutes mounts the resource under its own prefix. Middleware the whole
// controller needs goes here; which group it sits in, and so how it is
// exposed, is decided by routes.go, which calls this.
func (ctl *ProductsController) SetupRoutes(router *gin.RouterGroup) {
	products := router.Group("/products")
	products.GET("", ctl.Index)
	products.POST("", ctl.Create)
	products.GET("/:id", ctl.Show)
	products.PATCH("/:id", ctl.Update)
	products.DELETE("/:id", ctl.Destroy)
}

// Index handles GET /admin/products.
func (ctl *ProductsController) Index(c *gin.Context) {
	admin_products, err := ctl.Store.ListAdminProducts(c.Request.Context(), adminProductsListLimit)
	if err != nil {
		ctl.fail(c, err)
		return
	}
	c.JSON(http.StatusOK, adminProductsView(admin_products))
}

// Show handles GET /admin/products/:id.
func (ctl *ProductsController) Show(c *gin.Context) {
	a, err := ctl.Store.GetAdminProduct(c.Request.Context(), c.Param("id"))
	if err != nil {
		ctl.fail(c, err)
		return
	}
	c.JSON(http.StatusOK, adminProductView(a))
}

// Create handles POST /admin/products.
func (ctl *ProductsController) Create(c *gin.Context) {
	var req views.AdminProductRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, views.Error(err))
		return
	}
	a, err := ctl.Store.CreateAdminProduct(c.Request.Context(), models.AdminProduct{Name: req.Name})
	if err != nil {
		ctl.fail(c, err)
		return
	}
	c.JSON(http.StatusCreated, adminProductView(a))
}

// Update handles PATCH /admin/products/:id. Only the fields in the body change: the admin_product is loaded,
// the body is decoded over its current values,
// so a key left out keeps its value, and the result is saved and validated
// whole.
func (ctl *ProductsController) Update(c *gin.Context) {
	a, err := ctl.Store.GetAdminProduct(c.Request.Context(), c.Param("id"))
	if err != nil {
		ctl.fail(c, err)
		return
	}
	req := views.AdminProductRequest{Name: a.Name}
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, views.Error(err))
		return
	}
	a, err = ctl.Store.UpdateAdminProduct(c.Request.Context(), models.AdminProduct{ID: a.ID, Name: req.Name})
	if err != nil {
		ctl.fail(c, err)
		return
	}
	c.JSON(http.StatusOK, adminProductView(a))
}

// Destroy handles DELETE /admin/products/:id.
func (ctl *ProductsController) Destroy(c *gin.Context) {
	if err := ctl.Store.DeleteAdminProduct(c.Request.Context(), c.Param("id")); err != nil {
		ctl.fail(c, err)
		return
	}
	c.Status(http.StatusNoContent)
}

// fail maps a domain error to a status, the one place that mapping lives:
// not found is 404, a validation failure is 422, and anything
// else is logged and answered 500 without leaking its text.
func (ctl *ProductsController) fail(c *gin.Context, err error) {
	switch {
	case errors.Is(err, models.ErrNotFound):
		c.JSON(http.StatusNotFound, views.ErrorMessage("no such admin_product"))
	case errors.Is(err, models.ErrInvalid):
		c.JSON(http.StatusUnprocessableEntity, views.Error(err))
	default:
		ctl.Log.ErrorContext(c.Request.Context(), "admin_products: request failed",
			"path", c.FullPath(), "err", err, "request_id", c.GetString("request_id"))
		c.JSON(http.StatusInternalServerError, views.ErrorMessage("internal error"))
	}
}

// The controller converts between the domain and the wire. views never
// imports domain, so this is where AdminProductResponse is built.

func adminProductView(a models.AdminProduct) views.AdminProductResponse {
	return views.AdminProductResponse{
		ID:        a.ID,
		Name:      a.Name,
		CreatedAt: a.CreatedAt,
		UpdatedAt: a.UpdatedAt,
	}
}

func adminProductsView(admin_products []models.AdminProduct) views.AdminProductsResponse {
	out := views.AdminProductsResponse{AdminProducts: make([]views.AdminProductResponse, 0, len(admin_products))}
	for _, a := range admin_products {
		out.AdminProducts = append(out.AdminProducts, adminProductView(a))
	}
	return out
}
