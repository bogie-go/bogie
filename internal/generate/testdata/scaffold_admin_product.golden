package factories

import (
	"context"

	"example.com/blog/app/models"
	"example.com/blog/db/adapter"
)

// NewAdminProduct is a valid admin_product that is not saved: every attribute has a default,
// and "with" overrides what the spec cares about.
//
// Written once by `bogie g model` and yours to edit: add an attribute's
// default here when you add the column. Running the generator again leaves a
// changed file alone unless --force.
func NewAdminProduct(with ...func(*models.AdminProduct)) models.AdminProduct {
	record := models.AdminProduct{
		Name: Sequence("name "),
	}
	for _, f := range with {
		f(&record)
	}
	return record
}

// AdminProduct saves a NewAdminProduct through the real store and fails the spec if it
// cannot, so a spec reads as its arrangement and nothing else.
func AdminProduct(t T, s *adapter.Store, with ...func(*models.AdminProduct)) models.AdminProduct {
	t.Helper()
	created, err := s.CreateAdminProduct(context.Background(), NewAdminProduct(with...))
	if err != nil {
		t.Fatal(err)
	}
	return created
}
