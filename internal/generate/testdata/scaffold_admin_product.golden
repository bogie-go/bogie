==> db/adapter/admin_products.go
package adapter

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"

	"example.com/blog/app/models"
	"example.com/blog/db/sqlc"
)

// AdminProducts, as the models see them. Each method converts models.AdminProduct to and from
// the row type sqlc generated, and maps pgx's "no rows" to models.ErrNotFound
// so callers never import pgx to ask a question.
//
// Written by `bogie g model`: overwritten whole on the next run. A
// hand-written addition goes in admin_products_extra.go, not here.

// CreateAdminProduct validates an admin_product, inserts it, and returns it with its id and
// timestamps. Validation runs on save, so every caller
// gets it and none can forget it.
func (s *Store) CreateAdminProduct(ctx context.Context, a models.AdminProduct) (models.AdminProduct, error) {
	if err := a.Validate(); err != nil {
		return models.AdminProduct{}, err
	}
	row, err := s.q.CreateAdminProduct(ctx, a.Name)
	if err != nil {
		return models.AdminProduct{}, fmt.Errorf("store: create admin_product: %w", err)
	}
	return admin_productFromRow(row), nil
}

// GetAdminProduct finds one admin_product. An id that is not a valid id is simply not found.
func (s *Store) GetAdminProduct(ctx context.Context, id string) (models.AdminProduct, error) {
	pk, err := parseID(id)
	if err != nil {
		return models.AdminProduct{}, models.ErrNotFound
	}
	row, err := s.q.GetAdminProduct(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return models.AdminProduct{}, models.ErrNotFound
	case err != nil:
		return models.AdminProduct{}, fmt.Errorf("store: get admin_product %s: %w", id, err)
	}
	return admin_productFromRow(row), nil
}

// ListAdminProducts returns the newest admin_products first, at most limit of them.
func (s *Store) ListAdminProducts(ctx context.Context, limit int32) ([]models.AdminProduct, error) {
	rows, err := s.q.ListAdminProducts(ctx, limit)
	if err != nil {
		return nil, fmt.Errorf("store: list admin_products: %w", err)
	}
	out := make([]models.AdminProduct, 0, len(rows))
	for _, r := range rows {
		out = append(out, admin_productFromRow(r))
	}
	return out, nil
}

// UpdateAdminProduct validates an admin_product, writes its columns, and returns the stored row.
func (s *Store) UpdateAdminProduct(ctx context.Context, a models.AdminProduct) (models.AdminProduct, error) {
	if err := a.Validate(); err != nil {
		return models.AdminProduct{}, err
	}
	pk := a.ID
	row, err := s.q.UpdateAdminProduct(ctx, sqlc.UpdateAdminProductParams{ID: pk, Name: a.Name})
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return models.AdminProduct{}, models.ErrNotFound
	case err != nil:
		return models.AdminProduct{}, fmt.Errorf("store: update admin_product %v: %w", a.ID, err)
	}
	return admin_productFromRow(row), nil
}

// DeleteAdminProduct removes an admin_product, and says so if there was none.
func (s *Store) DeleteAdminProduct(ctx context.Context, id string) error {
	pk, err := parseID(id)
	if err != nil {
		return models.ErrNotFound
	}
	n, err := s.q.DeleteAdminProduct(ctx, pk)
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return fmt.Errorf("%w: admin_product is still in use", models.ErrInvalid)
		}
		return fmt.Errorf("store: delete admin_product %s: %w", id, err)
	}
	if n == 0 {
		return models.ErrNotFound
	}
	return nil
}

func admin_productFromRow(r sqlc.AdminProduct) models.AdminProduct {
	return models.AdminProduct{
		ID:        r.ID,
		Name:      r.Name,
		CreatedAt: r.CreatedAt.Time,
		UpdatedAt: r.UpdatedAt.Time,
	}
}
