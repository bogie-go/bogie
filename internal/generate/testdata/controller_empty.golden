==> app/controllers/health_controller/server.go
// Package health_controller is the HTTP surface of health. One file per action; the
// routes in routes.go; the dependencies here, as interfaces declared by this
// package (rule 2), holding only the methods this controller calls.
package health_controller

import (
	"log/slog"
)

// Server holds the controller's dependencies. Add what the actions need as
// a small interface declared here, and pass the real thing in from
// app/application.go, where this controller is wired:
//
//	type service interface {
//		Get(ctx context.Context, id string) (domain.Thing, error)
//	}
type Server struct {
	Log *slog.Logger
}

// NewServer builds the controller.
func NewServer(log *slog.Logger) *Server {
	return &Server{Log: log}
}
==> app/controllers/health_controller/routes.go
package health_controller

import "github.com/gin-gonic/gin"

// SetupRoutes mounts the controller under its own prefix. Middleware the
// whole group needs goes here; the exposure boundary stays visible in
// app/controllers/routes.go, which calls this.
func (s *Server) SetupRoutes(router *gin.RouterGroup) {
	health := router.Group("/health")
	_ = health // no actions yet; add them above and mount them here
}
==> app/controllers/health_controller/health_test.go
package health_controller

import (
	"io"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/gin-gonic/gin"
)

// Every action is mounted: a route that answers 404 was never registered.
func TestRoutesAreMounted(t *testing.T) {
	gin.SetMode(gin.TestMode)
	router := gin.New()
	NewServer(slog.New(slog.NewTextHandler(io.Discard, nil))).SetupRoutes(&router.RouterGroup)

	routes := []struct{ method, path string }{
	}
	for _, r := range routes {
		rec := httptest.NewRecorder()
		router.ServeHTTP(rec, httptest.NewRequest(r.method, r.path, nil))
		if rec.Code == http.StatusNotFound {
			t.Errorf("%s %s is not mounted", r.method, r.path)
		}
	}
}
