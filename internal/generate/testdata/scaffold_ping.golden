package models_test

import (
	"strconv"

	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"

	"example.com/blog/app/domain"
	"example.com/blog/test/factories"
)

var _ = Describe("Pings", func() {
	Describe("GetPing", func() {
		DescribeTable("is not found for",
			func(id string) {
				_, err := store.GetPing(GinkgoT().Context(), id)
				Expect(err).To(MatchError(domain.ErrNotFound))
			},
			Entry("a malformed id", "nope"),
			Entry("an empty id", ""),
			Entry("a well-formed id that names nothing", "999999999"),
		)

		Context("with a saved ping", func() {
			var record domain.Ping

			BeforeEach(func() {
				record = factories.Ping(GinkgoT(), store)
			})

			It("finds the ping by id", func() {
				Expect(store.GetPing(GinkgoT().Context(), strconv.FormatInt(record.ID, 10))).To(Equal(record))
			})
		})
	})

	Describe("ListPings", func() {
		Context("with a saved ping", func() {
			var record domain.Ping

			BeforeEach(func() {
				record = factories.Ping(GinkgoT(), store)
			})

			It("includes the saved ping", func() {
				all, err := store.ListPings(GinkgoT().Context(), 10)
				Expect(err).NotTo(HaveOccurred())
				Expect(all).To(HaveLen(1))
				Expect(all[0].ID).To(Equal(record.ID))
			})
		})
	})

	Describe("UpdatePing", func() {
		Context("with a saved ping", func() {
			var record domain.Ping

			BeforeEach(func() {
				record = factories.Ping(GinkgoT(), store)
			})

			It("saves the ping", func() {
				updated, err := store.UpdatePing(GinkgoT().Context(), record)
				Expect(err).NotTo(HaveOccurred())
				Expect(updated.ID).To(Equal(record.ID))
			})
		})

		Context("when the ping is not there", func() {
			var missing domain.Ping

			BeforeEach(func() {
				missing = factories.NewPing()
				missing.ID = 999999999
			})

			It("is not found", func() {
				_, err := store.UpdatePing(GinkgoT().Context(), missing)
				Expect(err).To(MatchError(domain.ErrNotFound))
			})
		})
	})

	Describe("DeletePing", func() {
		DescribeTable("is not found for",
			func(id string) {
				Expect(store.DeletePing(GinkgoT().Context(), id)).To(MatchError(domain.ErrNotFound))
			},
			Entry("a malformed id", "nope"),
			Entry("an empty id", ""),
			Entry("a well-formed id that names nothing", "999999999"),
		)

		Context("with a saved ping", func() {
			var record domain.Ping

			BeforeEach(func() {
				record = factories.Ping(GinkgoT(), store)
			})

			It("removes the ping", func() {
				id := strconv.FormatInt(record.ID, 10)
				Expect(store.DeletePing(GinkgoT().Context(), id)).To(Succeed())
				_, err := store.GetPing(GinkgoT().Context(), id)
				Expect(err).To(MatchError(domain.ErrNotFound))
			})
		})
	})
})
==> test/factories/pings.go
package factories

import (
	"context"

	"example.com/blog/app/domain"
	"example.com/blog/app/models"
)

// NewPing is a valid ping that is not saved: every attribute has a default,
// and "with" overrides what the spec cares about.
//
// Written once by `bogie g model` and yours to edit: add an attribute's
// default here when you add the column. Running the generator again leaves a
// changed file alone unless --force.
func NewPing(with ...func(*domain.Ping)) domain.Ping {
	record := domain.Ping{}
	for _, f := range with {
		f(&record)
	}
	return record
}

// Ping saves a NewPing through the real store and fails the spec if it
// cannot, so a spec reads as its arrangement and nothing else.
func Ping(t T, s *models.Store, with ...func(*domain.Ping)) domain.Ping {
	t.Helper()
	created, err := s.CreatePing(context.Background(), NewPing(with...))
	if err != nil {
		t.Fatal(err)
	}
	return created
}
