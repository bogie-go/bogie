package controllers_test

import (
	"fmt"
	"net/http"

	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"

	"example.com/blog/app/domain"
	"example.com/blog/app/views"
	"example.com/blog/test/factories"
)

var _ = Describe("GET /pings", func() {
	Context("with no pings", func() {
		It("is an empty list", func() {
			app.Get("/pings").Do().Status(http.StatusOK).Contains("\"pings\":[]")
		})
	})

	Context("with pings", func() {
		var first, second domain.Ping

		BeforeEach(func() {
			first = factories.Ping(GinkgoT(), app.Store)
			second = factories.Ping(GinkgoT(), app.Store)
		})

		It("lists them, newest first", func() {
			var list views.PingsResponse
			app.Get("/pings").Do().Status(http.StatusOK).JSON(&list)

			Expect(list.Pings).To(HaveLen(2))
			Expect(list.Pings[0].ID).To(Equal(second.ID))
			Expect(list.Pings[1].ID).To(Equal(first.ID))
		})
	})
})

var _ = Describe("GET /pings/:id", func() {
	Context("when the ping exists", func() {
		var record domain.Ping

		BeforeEach(func() {
			record = factories.Ping(GinkgoT(), app.Store)
		})

		It("shows it", func() {
			var shown views.PingResponse
			app.Get("/pings/" + fmt.Sprint(record.ID)).Do().Status(http.StatusOK).JSON(&shown)

			Expect(shown.ID).To(Equal(record.ID))
		})
	})

	Context("when the ping does not exist", func() {
		It("is not found", func() {
			app.Get("/pings/999999999").Do().Status(http.StatusNotFound)
		})
	})
})

var _ = Describe("POST /pings", func() {
	Context("with no attributes to send", func() {
		It("creates one", func() {
			app.Post("/pings", nil).Do().Status(http.StatusCreated)
		})
	})
})

var _ = Describe("PATCH /pings/:id", func() {
	Context("when the ping exists", func() {
		var record domain.Ping

		BeforeEach(func() {
			record = factories.Ping(GinkgoT(), app.Store)
		})

		It("keeps it as it is when nothing is sent", func() {
			var updated views.PingResponse
			app.Patch("/pings/"+fmt.Sprint(record.ID), map[string]any{}).Do().Status(http.StatusOK).JSON(&updated)

			Expect(updated.ID).To(Equal(record.ID))
		})
	})

	Context("when the ping does not exist", func() {
		It("is not found", func() {
			app.Patch("/pings/999999999", map[string]any{}).Do().Status(http.StatusNotFound)
		})
	})
})

var _ = Describe("DELETE /pings/:id", func() {
	Context("when the ping exists", func() {
		var record domain.Ping

		BeforeEach(func() {
			record = factories.Ping(GinkgoT(), app.Store)
		})

		It("deletes it", func() {
			app.Delete("/pings/" + fmt.Sprint(record.ID)).Do().Status(http.StatusNoContent)

			app.Get("/pings/" + fmt.Sprint(record.ID)).Do().Status(http.StatusNotFound)
		})
	})

	Context("when the ping does not exist", func() {
		It("is not found", func() {
			app.Delete("/pings/999999999").Do().Status(http.StatusNotFound)
		})
	})
})
