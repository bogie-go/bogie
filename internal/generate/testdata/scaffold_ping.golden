package domain

import (
	"time"
)

// Ping is a ping. Imports nothing third-party: ids are int64s here and
// become bigint at the store boundary.
type Ping struct {
	ID        int64
	CreatedAt time.Time
	UpdatedAt time.Time
}

// Validate is the model's validations, as Rails would put them. Wrap every
// failure in ErrInvalid so a controller can answer 422 without knowing the
// rule:
//
//	return fmt.Errorf("%w: title is required", ErrInvalid)
func (p Ping) Validate() error {
	return nil
}
==> app/models/pings.go
package models

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"

	"example.com/blog/app/domain"
	"example.com/blog/db/sqlc"
)

// Pings, as the domain sees them. Each method converts domain.Ping to and from
// the row type sqlc generated, and maps pgx's "no rows" to domain.ErrNotFound
// so callers never import pgx to ask a question.
//
// Written by `bogie g model`: overwritten whole on the next run. A
// hand-written addition goes in pings_extra.go, not here.

// CreatePing validates a ping, inserts it, and returns it with its id and
// timestamps. Validation runs on save, as Rails's does, so every caller
// gets it and none can forget it.
func (s *Store) CreatePing(ctx context.Context, p domain.Ping) (domain.Ping, error) {
	if err := p.Validate(); err != nil {
		return domain.Ping{}, err
	}
	row, err := s.q.CreatePing(ctx)
	if err != nil {
		return domain.Ping{}, fmt.Errorf("models: create ping: %w", err)
	}
	return pingFromRow(row), nil
}

// GetPing finds one ping. An id that is not a valid id is simply not found.
func (s *Store) GetPing(ctx context.Context, id string) (domain.Ping, error) {
	pk, err := parseID(id)
	if err != nil {
		return domain.Ping{}, domain.ErrNotFound
	}
	row, err := s.q.GetPing(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.Ping{}, domain.ErrNotFound
	case err != nil:
		return domain.Ping{}, fmt.Errorf("models: get ping %s: %w", id, err)
	}
	return pingFromRow(row), nil
}

// ListPings returns the newest pings first, at most limit of them.
func (s *Store) ListPings(ctx context.Context, limit int32) ([]domain.Ping, error) {
	rows, err := s.q.ListPings(ctx, limit)
	if err != nil {
		return nil, fmt.Errorf("models: list pings: %w", err)
	}
	out := make([]domain.Ping, 0, len(rows))
	for _, r := range rows {
		out = append(out, pingFromRow(r))
	}
	return out, nil
}

// UpdatePing validates a ping, writes its columns, and returns the stored row.
func (s *Store) UpdatePing(ctx context.Context, p domain.Ping) (domain.Ping, error) {
	if err := p.Validate(); err != nil {
		return domain.Ping{}, err
	}
	pk := p.ID
	row, err := s.q.UpdatePing(ctx, pk)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domain.Ping{}, domain.ErrNotFound
	case err != nil:
		return domain.Ping{}, fmt.Errorf("models: update ping %v: %w", p.ID, err)
	}
	return pingFromRow(row), nil
}

// DeletePing removes a ping, and says so if there was none.
func (s *Store) DeletePing(ctx context.Context, id string) error {
	pk, err := parseID(id)
	if err != nil {
		return domain.ErrNotFound
	}
	n, err := s.q.DeletePing(ctx, pk)
	if err != nil {
		var pgErr *pgconn.PgError
		if errors.As(err, &pgErr) && pgErr.Code == "23503" {
			return fmt.Errorf("%w: ping is still in use", domain.ErrInvalid)
		}
		return fmt.Errorf("models: delete ping %s: %w", id, err)
	}
	if n == 0 {
		return domain.ErrNotFound
	}
	return nil
}

func pingFromRow(r sqlc.Ping) domain.Ping {
	return domain.Ping{
		ID:        r.ID,
		CreatedAt: r.CreatedAt.Time,
		UpdatedAt: r.UpdatedAt.Time,
	}
}
