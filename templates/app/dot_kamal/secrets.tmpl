# Secrets for `kamal deploy`, which targets STAGING. Kamal reads this file
# and substitutes each value into config/deploy.yml's `secret:` lists.
#
# Everything lives in the encrypted credentials; only the decryption key
# stays on disk, and config/credentials/staging.key is gitignored and copied
# between machines by hand. The key is made by `make credentials ENV=staging`
# the first time, together with the file it opens.
#
# `go tool credentials get` prints one value without booting anything; it is
# the pinned tool from go.mod, so nothing has to be installed.

{{.EnvPrefix}}_MASTER_KEY=$(cat config/credentials/staging.key)

KAMAL_REGISTRY_PASSWORD=$(go tool credentials get -e staging kamal.registry_password)
