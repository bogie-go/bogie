# PRODUCTION secrets. Kamal reads .kamal/secrets.<destination>, so this file
# is what `kamal deploy -d production` uses, and .kamal/secrets (staging) is
# not consulted. Same shape, different key and different credentials file.
#
# Before the first production deploy, `make credentials ENV=production` must
# have made config/credentials/production.yml.enc and its key, with at least
# {{.Name}}.database_url and kamal.registry_password in it. The service
# refuses to boot without a database URL, which is deliberate.

{{.EnvPrefix}}_MASTER_KEY=$(cat config/credentials/production.key)

KAMAL_REGISTRY_PASSWORD=$(go tool credentials get -e production kamal.registry_password)
