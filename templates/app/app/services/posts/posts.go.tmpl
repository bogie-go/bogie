// Package posts is the example service: what a controller, a job or a CLI
// calls to do something with posts. ctx first; it knows nothing about HTTP,
// so the webhook, the test and a replay command all call the same functions.
package posts

import (
	"context"

	"{{.Module}}/app/domain"
)

// store is the slice of persistence this package uses, declared HERE, next to
// its caller, rather than imported from models. It holds only what this
// package calls, which is what makes the fake in posts_test.go a few lines
// long instead of a mock of the whole database. *models.Store satisfies it
// without ever mentioning this package.
type store interface {
	CreatePost(ctx context.Context, p domain.Post) (domain.Post, error)
	GetPost(ctx context.Context, id string) (domain.Post, error)
	ListPosts(ctx context.Context, limit int32) ([]domain.Post, error)
	UpdatePost(ctx context.Context, p domain.Post) (domain.Post, error)
	DeletePost(ctx context.Context, id string) error
}

// listLimit bounds a listing until there is pagination to bound it.
const listLimit = 100

// Service does things with posts.
type Service struct {
	store store
}

// New builds the service.
func New(store store) *Service {
	return &Service{store: store}
}

// Create validates and stores a new post.
func (s *Service) Create(ctx context.Context, title, body string) (domain.Post, error) {
	p := domain.Post{Title: title, Body: body}
	if err := p.Validate(); err != nil {
		return domain.Post{}, err
	}
	return s.store.CreatePost(ctx, p)
}

// Get finds one post, or domain.ErrNotFound.
func (s *Service) Get(ctx context.Context, id string) (domain.Post, error) {
	return s.store.GetPost(ctx, id)
}

// List returns the newest posts first.
func (s *Service) List(ctx context.Context) ([]domain.Post, error) {
	return s.store.ListPosts(ctx, listLimit)
}

// Update changes a post's title and body, validating the result.
func (s *Service) Update(ctx context.Context, id, title, body string) (domain.Post, error) {
	p, err := s.store.GetPost(ctx, id)
	if err != nil {
		return domain.Post{}, err
	}
	p.Title, p.Body = title, body
	if err := p.Validate(); err != nil {
		return domain.Post{}, err
	}
	return s.store.UpdatePost(ctx, p)
}

// Delete removes a post, or domain.ErrNotFound.
func (s *Service) Delete(ctx context.Context, id string) error {
	return s.store.DeletePost(ctx, id)
}
