package posts_controller

import (
	"net/http"

	"github.com/gin-gonic/gin"

	"{{.Module}}/app/views"
)

// Update handles PATCH /posts/:id.
func (s *Server) Update(c *gin.Context) {
	var req views.PostRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, views.Error(err))
		return
	}
	post, err := s.Posts.Update(c.Request.Context(), c.Param("id"), req.Title, req.Body)
	if err != nil {
		s.fail(c, err)
		return
	}
	c.JSON(http.StatusOK, postView(post))
}
