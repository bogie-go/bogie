package posts_controller

import (
	"context"
	"encoding/json"
	"errors"
	"io"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/gin-gonic/gin"

	"{{.Module}}/app/domain"
)

// A fake of the service interface declared in server.go: it records what the
// controller asked for and answers with what the test chose.
type fakeService struct {
	post  domain.Post
	posts []domain.Post
	err   error

	gotID, gotTitle, gotBody string
}

func (f *fakeService) Create(_ context.Context, title, body string) (domain.Post, error) {
	f.gotTitle, f.gotBody = title, body
	return f.post, f.err
}

func (f *fakeService) Get(_ context.Context, id string) (domain.Post, error) {
	f.gotID = id
	return f.post, f.err
}

func (f *fakeService) List(context.Context) ([]domain.Post, error) { return f.posts, f.err }

func (f *fakeService) Update(_ context.Context, id, title, body string) (domain.Post, error) {
	f.gotID, f.gotTitle, f.gotBody = id, title, body
	return f.post, f.err
}

func (f *fakeService) Delete(_ context.Context, id string) error {
	f.gotID = id
	return f.err
}

func request(t *testing.T, svc *fakeService, method, path, body string) *httptest.ResponseRecorder {
	t.Helper()
	gin.SetMode(gin.TestMode)
	router := gin.New()
	NewServer(svc, slog.New(slog.NewTextHandler(io.Discard, nil))).SetupRoutes(&router.RouterGroup)

	rec := httptest.NewRecorder()
	req := httptest.NewRequest(method, path, strings.NewReader(body))
	req.Header.Set("Content-Type", "application/json")
	router.ServeHTTP(rec, req)
	return rec
}

func TestIndexListsPosts(t *testing.T) {
	svc := &fakeService{posts: []domain.Post{
		{ID: "a", Title: "One"},
		{ID: "b", Title: "Two"},
	}}
	rec := request(t, svc, http.MethodGet, "/posts", "")

	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d: %s", rec.Code, rec.Body)
	}
	var body struct {
		Posts []struct{ ID, Title string } `json:"posts"`
	}
	if err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {
		t.Fatal(err)
	}
	if len(body.Posts) != 2 || body.Posts[1].Title != "Two" {
		t.Errorf("body = %+v", body)
	}
}

func TestShowUnknownPostIs404(t *testing.T) {
	rec := request(t, &fakeService{err: domain.ErrNotFound}, http.MethodGet, "/posts/nope", "")
	if rec.Code != http.StatusNotFound {
		t.Errorf("status = %d, want 404", rec.Code)
	}
}

func TestCreatePassesTheBodyThroughAndAnswers201(t *testing.T) {
	svc := &fakeService{post: domain.Post{ID: "a", Title: "Hello", Body: "world"}}
	rec := request(t, svc, http.MethodPost, "/posts", `{"title":"Hello","body":"world"}`)

	if rec.Code != http.StatusCreated {
		t.Fatalf("status = %d: %s", rec.Code, rec.Body)
	}
	if svc.gotTitle != "Hello" || svc.gotBody != "world" {
		t.Errorf("service got title=%q body=%q", svc.gotTitle, svc.gotBody)
	}
	if !strings.Contains(rec.Body.String(), `"id":"a"`) {
		t.Errorf("body = %s", rec.Body)
	}
}

// Validation is the domain's. The controller's only job is to say 422.
func TestCreateInvalidIs422(t *testing.T) {
	svc := &fakeService{err: errors.Join(domain.ErrInvalid, errors.New("title is required"))}
	rec := request(t, svc, http.MethodPost, "/posts", `{"title":""}`)
	if rec.Code != http.StatusUnprocessableEntity {
		t.Errorf("status = %d, want 422: %s", rec.Code, rec.Body)
	}
}

func TestCreateMalformedJSONIs400(t *testing.T) {
	rec := request(t, &fakeService{}, http.MethodPost, "/posts", `{"title":`)
	if rec.Code != http.StatusBadRequest {
		t.Errorf("status = %d, want 400", rec.Code)
	}
}

func TestDestroyAnswers204(t *testing.T) {
	svc := &fakeService{}
	rec := request(t, svc, http.MethodDelete, "/posts/a", "")
	if rec.Code != http.StatusNoContent || svc.gotID != "a" {
		t.Errorf("status = %d, id = %q", rec.Code, svc.gotID)
	}
}

// An unexpected error is a 500 that says nothing about its cause.
func TestUnexpectedErrorIs500WithoutDetail(t *testing.T) {
	rec := request(t, &fakeService{err: errors.New("connection refused to db-1")}, http.MethodGet, "/posts", "")
	if rec.Code != http.StatusInternalServerError {
		t.Errorf("status = %d, want 500", rec.Code)
	}
	if strings.Contains(rec.Body.String(), "db-1") {
		t.Errorf("body leaks the internal error: %s", rec.Body)
	}
}
