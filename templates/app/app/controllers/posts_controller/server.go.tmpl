// Package posts_controller is the HTTP surface of the example resource: a
// plain JSON CRUD, the shape every generated controller follows. One file per
// action; the routes in routes.go; the dependencies here, as interfaces
// declared by this package.
package posts_controller

import (
	"context"
	"errors"
	"log/slog"
	"net/http"

	"github.com/gin-gonic/gin"

	"{{.Module}}/app/domain"
	"{{.Module}}/app/views"
)

// service is the slice of the posts service this controller uses, declared
// next to its caller. *posts.Service satisfies it; the test's fake is a few
// lines.
type service interface {
	Create(ctx context.Context, title, body string) (domain.Post, error)
	Get(ctx context.Context, id string) (domain.Post, error)
	List(ctx context.Context) ([]domain.Post, error)
	Update(ctx context.Context, id, title, body string) (domain.Post, error)
	Delete(ctx context.Context, id string) error
}

// Server holds the controller's dependencies.
type Server struct {
	Posts service
	Log   *slog.Logger
}

// NewServer builds the controller.
func NewServer(posts service, log *slog.Logger) *Server {
	return &Server{Posts: posts, Log: log}
}

// fail maps a domain error to a status, the one place that mapping lives:
// not found is 404, a validation failure is 422 as in Rails, and anything
// else is logged and answered 500 without leaking its text.
func (s *Server) fail(c *gin.Context, err error) {
	switch {
	case errors.Is(err, domain.ErrNotFound):
		c.JSON(http.StatusNotFound, views.ErrorMessage("no such post"))
	case errors.Is(err, domain.ErrInvalid):
		c.JSON(http.StatusUnprocessableEntity, views.Error(err))
	default:
		s.Log.ErrorContext(c.Request.Context(), "posts: request failed",
			"path", c.FullPath(), "err", err, "request_id", c.GetString("request_id"))
		c.JSON(http.StatusInternalServerError, views.ErrorMessage("internal error"))
	}
}

// The controller converts between the domain and the wire. views never
// imports domain, so this is where PostResponse is built.

func postView(p domain.Post) views.PostResponse {
	return views.PostResponse{ID: p.ID, Title: p.Title, Body: p.Body, CreatedAt: p.CreatedAt, UpdatedAt: p.UpdatedAt}
}

func postsView(ps []domain.Post) views.PostsResponse {
	out := views.PostsResponse{Posts: make([]views.PostResponse, 0, len(ps))}
	for _, p := range ps {
		out.Posts = append(out.Posts, postView(p))
	}
	return out
}
