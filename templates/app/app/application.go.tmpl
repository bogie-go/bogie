// Package app wires the process together: configuration, connections,
// controllers. It is the only place that knows how every part fits, which
// keeps that knowledge out of the packages themselves.
package app

import (
	"context"
	"log/slog"
	"os"
{{if .Jobs}}
	"github.com/jackc/pgx/v5"
	"github.com/riverqueue/river"
	"github.com/riverqueue/river/riverdriver/riverpgxv5"
{{end}}
	"{{.Module}}/app/controllers"
	"{{.Module}}/app/controllers/posts_controller"{{if .Jobs}}
	"{{.Module}}/app/jobs"{{end}}
	"{{.Module}}/app/models"
	"{{.Module}}/app/services/migrate"
	"{{.Module}}/app/services/posts"
	"{{.Module}}/config"
	"{{.Module}}/lib/logger"
)

// Application holds everything the process needs.
type Application struct {
	Config config.Config
	Log    *slog.Logger
	Store  *models.Store
	Server *controllers.Server{{if .Jobs}}

	// Jobs enqueues background jobs from anywhere and, in the worker
	// process, works them. Never started by serve, so there it only inserts.
	Jobs *river.Client[pgx.Tx]
	// jobsRegistered is false until the first `bogie g job`: River refuses
	// an empty bundle, so until then the client is insert-only and the
	// worker idles.
	jobsRegistered bool{{end}}
}

// NewApplication loads configuration and opens every connection. It returns an
// error rather than exiting: only main decides to stop the process.
func NewApplication(ctx context.Context) (*Application, error) {
	cfg, err := config.Load()
	if err != nil {
		return nil, err
	}
	log := logger.New(cfg.App.LogLevel, cfg.Env)

	// Printed before anything connects, so a wrong setting shows up next to
	// the failure it causes rather than after it.
	if cfg.Env != config.EnvTest {
		cfg.PrintTo(os.Stderr)
	}

	// Schema first, then everything that depends on it. The migrations are
	// embedded in this binary, so the schema a container runs against is
	// always the one its code was built for. Failing here stops the deploy,
	// which is the point: serving traffic against a half-applied schema is
	// worse.
	if cfg.App.MigrateAtBoot {
		if err := migrate.Run(ctx, cfg.App.DatabaseURL, log); err != nil {
			return nil, err
		}
	}

	store, err := models.Open(ctx, cfg.App.DatabaseURL)
	if err != nil {
		return nil, err
	}
{{if .Jobs}}
	// River runs on the same Postgres, so a job enqueued in a transaction
	// commits with the business row or not at all. The workers are
	// registered in app/jobs; `bogie g job` adds one.
	workers, jobsRegistered := jobs.Workers(log)
	riverConfig := &river.Config{Logger: log}
	if jobsRegistered {
		// Queues and Workers go together: a client with either alone is
		// refused, and one with neither is insert-only.
		riverConfig.Queues = map[string]river.QueueConfig{river.QueueDefault: {MaxWorkers: 10}}
		riverConfig.Workers = workers
	} else {
		log.WarnContext(ctx, "no jobs registered yet: the queue accepts inserts and the worker has nothing to do (bogie g job NAME)")
	}
	queue, err := river.NewClient(riverpgxv5.New(store.Pool()), riverConfig)
	if err != nil {
		return nil, err
	}
{{end}}
	server := controllers.NewServer(cfg, log)

	// Each controller is built here, with its dependencies, and assigned to
	// its NAMED field on the root server. `bogie g controller` inserts one
	// line above the marker; by hand it is the same one line, as the example
	// resource shows:
	server.Posts = posts_controller.NewServer(posts.New(store), log)
	// bogie:wire
	server.SetupRoutes()

	return &Application{Config: cfg, Log: log, Store: store, Server: server{{if .Jobs}}, Jobs: queue, jobsRegistered: jobsRegistered{{end}}}, nil
}

// Start serves HTTP until ctx is cancelled.
func (a *Application) Start(ctx context.Context) error {
	defer a.Close()
	return a.Server.Start(ctx)
}

{{if .Jobs}}// StartWorker works the queue until ctx is cancelled, then drains.
func (a *Application) StartWorker(ctx context.Context) error {
	defer a.Close()
	if !a.jobsRegistered {
		a.Log.Info("worker idle: no jobs registered yet", "env", a.Config.Env)
		<-ctx.Done()
		return nil
	}
	if err := a.Jobs.Start(ctx); err != nil {
		return err
	}
	a.Log.Info("worker started", "env", a.Config.Env)
	<-ctx.Done()

	// In-flight jobs get the same grace a request does; after that River
	// marks what is still running as retryable and returns.
	a.Log.Info("worker draining", "grace", a.Config.App.ShutdownGrace)
	stopCtx, cancel := context.WithTimeout(context.Background(), a.Config.App.ShutdownGrace)
	defer cancel()
	return a.Jobs.Stop(stopCtx)
}

{{end}}// Close releases connections.
func (a *Application) Close() {
	if a.Store != nil {
		a.Store.Close()
	}
}
