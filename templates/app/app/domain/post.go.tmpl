package domain

import (
	"errors"
	"fmt"
	"strings"
	"time"
	"unicode/utf8"
)

// ErrNotFound is returned for an id that names nothing. An id that is not
// even a uuid gets the same answer: it cannot exist, and a caller should not
// be able to tell the two apart.
var ErrNotFound = errors.New("not found")

// ErrInvalid wraps every validation failure, so a controller can answer 422
// with errors.Is and never has to know the individual rules.
var ErrInvalid = errors.New("invalid")

// Post is the example resource every new app starts with.
type Post struct {
	ID        string
	Title     string
	Body      string
	CreatedAt time.Time
	UpdatedAt time.Time
}

// maxTitle bounds what a title can carry. The column is unconstrained text,
// so the rule lives here, in the one place that decides what a Post is.
const maxTitle = 200

// Validate is the model's validations, as Rails would put them.
func (p Post) Validate() error {
	if strings.TrimSpace(p.Title) == "" {
		return fmt.Errorf("%w: title is required", ErrInvalid)
	}
	if utf8.RuneCountInString(p.Title) > maxTitle {
		return fmt.Errorf("%w: title must be %d characters or fewer", ErrInvalid, maxTitle)
	}
	return nil
}
