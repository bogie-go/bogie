{{if eq .IDScheme "uuid"}}package adapter

import (
	"fmt"

	"github.com/jackc/pgx/v5/pgtype"
)

// The domain speaks strings; Postgres speaks uuid. Converting here rather than
// in db/adapter is what lets app/models import nothing third-party.

func parseUUID(s string) (pgtype.UUID, error) {
	var id pgtype.UUID
	if err := id.Scan(s); err != nil {
		return pgtype.UUID{}, fmt.Errorf("store: %q is not a uuid: %w", s, err)
	}
	return id, nil
}

func uuidString(id pgtype.UUID) string {
	if !id.Valid {
		return ""
	}
	v, err := id.Value()
	if err != nil {
		return ""
	}
	s, _ := v.(string)
	return s
}
{{- end}}
