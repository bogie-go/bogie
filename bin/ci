#!/bin/sh
# bin/ci: continuous integration for the bogie tool, run here.
#
# Rails 8.1's bin/ci, ported: every check in one file, run on the machine you
# already have. Every step runs even when an earlier one failed; the run fails
# if any step did; a green run on a clean tree ends with `gh signoff`.
#
# The last steps are what stops the templates rotting: generate an app into a
# temp dir and run ITS bin/ci, then start it and ask it for /healthz.
set -u
cd "$(dirname "$0")/.." || exit 1

failed=0
started=$(date +%s)

step() {
  name=$1
  command=$2
  printf '\n\033[1m== %s\033[0m\n' "$name"
  t=$(date +%s)
  case "$command" in
    lint|signoff|scaffold|image|generators|serves|reloads|teardown|jobs|teardown_jobs) "$command" ;;
    *) sh -c "$command" ;;
  esac
  if [ $? -eq 0 ]; then
    printf '\033[32m   ok\033[0m  %s (%ss)\n' "$name" "$(( $(date +%s) - t ))"
  else
    printf '\033[31m FAIL\033[0m  %s (%ss)\n' "$name" "$(( $(date +%s) - t ))"
    failed=1
  fi
}

lint() {
  if command -v golangci-lint >/dev/null 2>&1; then
    golangci-lint run ./...
  elif [ -x "$(go env GOPATH)/bin/golangci-lint" ]; then
    "$(go env GOPATH)/bin/golangci-lint" run ./...
  else
    echo "golangci-lint is not installed. Install it with:"
    echo "  go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest"
    return 1
  fi
}

# The generated app, held to its own bar. Kept in $CI_APP_DIR so the serve
# step below can use it and a failure can be inspected afterwards.
CI_APP_DIR=$(mktemp -d)
scaffold() {
  go build -o "$CI_APP_DIR/bogie" . || return 1
  (cd "$CI_APP_DIR" && ./bogie new blog --module=example.com/blog) || return 1
  echo "generated app: $CI_APP_DIR/blog"
  "$CI_APP_DIR/blog/bin/ci"
}

# The Dockerfile is a template too, so build it: the image must build from a
# fresh app, with the keys left out of the context.
image() {
  [ -d "$CI_APP_DIR/blog" ] || { echo "no generated app"; return 1; }
  docker build -q -t bogie-ci-blog "$CI_APP_DIR/blog" >/dev/null || return 1
  docker run --rm --entrypoint sh bogie-ci-blog -c 'test -f /app/config/credentials.yml.enc && ! test -f /app/config/master.key' || { echo "image carries the key, or not the credentials"; return 1; }
  docker rmi -f bogie-ci-blog >/dev/null
  echo "image builds, with the credentials and without the key"
}

# Every generator, run into that app, and the app's own bin/ci again: the
# generated code must build, lint, match sqlc and pass the app's tests, with
# the database rolled back and forward over the new migrations.
generators() {
  [ -d "$CI_APP_DIR/blog" ] || { echo "no generated app"; return 1; }
  cd "$CI_APP_DIR/blog" || return 1
  b="$CI_APP_DIR/bogie"
  "$b" g scaffold post title:string body:text || return 1
  # "session" and "category" are not arbitrary: a model whose name starts
  # with s, or a scaffold whose name starts with c, once generated a
  # parameter that shadowed the Store receiver or the *gin.Context and did
  # not compile. Only building the generated code catches that.
  "$b" g model session body:text post:references score:integer published_at:datetime meta:jsonb || return 1
  "$b" g scaffold category name:string || return 1
  "$b" g migration add_slug_to_posts slug:string:index || return 1
  "$b" g controller comments index show create update destroy search || return 1
  # A namespace: the first controller writes the package, the second joins it.
  "$b" g controller admin/reports index show || return 1
  "$b" g controller admin/audits index || return 1
  "$b" g service publish_post || return 1
  # The three authentication shapes: config lines, a development secret in
  # the credentials, new dependencies tidied in, a table for api_key.
  "$b" g authentication secret || return 1
  "$b" g authentication token || return 1
  "$b" g authentication api_key || return 1
  # This app has no jobs; the first `g job` adds River itself, the same way
  # `app:update` merges a layout change, before writing the job as usual. The
  # app's own bin/ci below then also covers the worker role it just gained.
  "$b" g job send_welcome || return 1
  "$b" doctor || return 1
  # Same version on both sides, so this is the no-op path; the merge itself
  # is unit-tested, and a real cross-version run needs the module proxy.
  "$b" app:update | grep -q "nothing to update" || return 1
  cd "$OLDPWD" || return 1
  "$CI_APP_DIR/blog/bin/ci" || return 1

  # And back out again: destroy must leave an app that still passes.
  cd "$CI_APP_DIR/blog" || return 1
  "$b" d job send_welcome || return 1
  "$b" d authentication api_key || return 1
  "$b" d authentication token || return 1
  "$b" d authentication secret || return 1
  "$b" d controller comments || return 1
  "$b" d controller admin/reports || return 1
  "$b" d controller admin/audits || return 1
  "$b" d service publish_post || return 1
  "$b" d migration add_slug_to_posts || return 1
  "$b" d scaffold category || return 1
  "$b" d model session || return 1
  "$b" d scaffold post || return 1
  "$b" doctor || return 1
  cd "$OLDPWD" || return 1
  "$CI_APP_DIR/blog/bin/ci"
}

serves() {
  [ -d "$CI_APP_DIR/blog" ] || { echo "no generated app to start"; return 1; }
  cd "$CI_APP_DIR/blog" || return 1
  BLOG_ENV=test BLOG_ADDR=:18080 go run . serve >"$CI_APP_DIR/serve.log" 2>&1 &
  pid=$!
  i=0
  until curl -fs localhost:18080/healthz >/dev/null 2>&1; do
    i=$((i + 1))
    if [ $i -ge 60 ]; then kill $pid 2>/dev/null; cat "$CI_APP_DIR/serve.log"; return 1; fi
    sleep 0.5
  done
  body=$(curl -fs localhost:18080/healthz)
  # `go run` compiles to a cache path and runs it as a child, so killing the
  # wrapper orphans the server and it keeps :18080. A leftover would answer
  # the next run's health check and make this step pass without serving.
  kill $pid 2>/dev/null; wait $pid 2>/dev/null
  pkill -f "go-build.*/blog serve" 2>/dev/null
  cd "$OLDPWD" || return 1
  [ "$body" = ok ] || { echo "GET /healthz = $body"; return 1; }
  echo "GET /healthz = ok"
}

# stop_group interrupts the process group of something started inside the
# generated app: Air, which runs the app as a child that a plain `kill` on
# the parent would orphan. Processes are matched by their
# working directory as well as their command, so a developer running bin/ci
# while their own `air` is up elsewhere never has it signalled.
stop_group() { # $1 = command pattern, $2 = app directory
  mine=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')
  for p in $(pgrep -f "$1" 2>/dev/null); do
    [ "$(readlink -f "/proc/$p/cwd" 2>/dev/null)" = "$2" ] || continue
    pg=$(ps -o pgid= -p "$p" 2>/dev/null | tr -d ' ')
    [ -n "$pg" ] || continue
    # Never this script's own group: a child started without setsid shares
    # it, and interrupting it would kill the run instead of the child.
    [ "$pg" = "$mine" ] && { echo "stop_group: $1 shares this script's process group; not signalling"; continue; }
    kill -INT -"$pg" 2>/dev/null
  done
}

# Live reload, the way a developer gets it: `bogie server` in development runs
# the app under Air, so a saved file rebuilds and restarts it. Checks the tool
# is pinned in the app's own go.mod, that the server comes up under reload, and
# that editing a file brings it back on its own.
reloads() {
  [ -d "$CI_APP_DIR/blog" ] || { echo "no generated app"; return 1; }
  cd "$CI_APP_DIR/blog" || return 1
  test -f .air.toml || { echo "the app has no .air.toml"; cd "$OLDPWD"; return 1; }
  go tool air -v >/dev/null 2>&1 || { echo "go tool air does not resolve from the app's go.mod"; cd "$OLDPWD"; return 1; }

  # Polls a path until it answers, so "it came back" means the rebuilt binary
  # is serving, not that the old one had not been stopped yet.
  reload_up() {
    i=0
    until curl -fs "localhost:18081$1" >/dev/null 2>&1; do
      i=$((i + 1))
      [ $i -ge 120 ] && return 1
      sleep 0.5
    done
  }
  reload_stop() {
    # `bogie server` is a proxy: killing it leaves Air, and Air leaves the
    # binary it built. Both outlive the step and hold :18081 for the next
    # run, so interrupt the group and wait for it to go.
    stop_group "air -c .air.toml" "$CI_APP_DIR/blog"
    kill $pid 2>/dev/null
    wait $pid 2>/dev/null
    i=0
    while [ $i -lt 30 ]; do
      pgrep -f "$CI_APP_DIR/blog/tmp/blog" >/dev/null 2>&1 || break
      i=$((i + 1))
      sleep 0.5
    done
    pkill -f "$CI_APP_DIR/blog/tmp/blog" 2>/dev/null
    cd "$OLDPWD" || return 1
  }

  # Development, because reload is development-only, so this needs the
  # development database rather than the test one bin/ci rebuilt.
  go run . db prepare >"$CI_APP_DIR/reload.log" 2>&1 || { cat "$CI_APP_DIR/reload.log"; cd "$OLDPWD"; return 1; }
  # setsid, so Air gets a process group of its own. Without it Air shares
  # this script's group, and interrupting that group to stop Air stops
  # bin/ci too.
  BLOG_ADDR=:18081 setsid "$CI_APP_DIR/bogie" server >>"$CI_APP_DIR/reload.log" 2>&1 &
  pid=$!
  reload_up /healthz || { echo "did not come up under reload"; cat "$CI_APP_DIR/reload.log"; reload_stop; return 1; }

  # A route that does not exist yet: it can only answer if the file was
  # noticed, rebuilt and restarted.
  sed -i 's|r.GET("/healthz".*|&\n\tr.GET("/reloaded", func(c *gin.Context) { c.String(http.StatusOK, "yes") })|' app/controllers/routes.go
  reload_up /reloaded || { echo "a new route did not appear after the file changed"; cat "$CI_APP_DIR/reload.log"; reload_stop; return 1; }
  sed -i '/"\/reloaded"/d' app/controllers/routes.go
  reload_stop
  echo "reload: served, picked up a new route on save, served it"
}

# A second app, with --jobs: the worker role, River, g job and d job, and
# that app's own bin/ci, which boots the worker. Same app name, so it reuses
# the compose project the first one tore down.
CI_JOBS_DIR=$(mktemp -d)
jobs() {
  (cd "$CI_JOBS_DIR" && "$CI_APP_DIR/bogie" new blog --module=example.com/blog --jobs) || return 1
  cd "$CI_JOBS_DIR/blog" || return 1
  b="$CI_APP_DIR/bogie"
  "$b" g job send_welcome || return 1
  "$b" g job send_welcome || return 1
  "$b" doctor || return 1
  cd "$OLDPWD" || return 1
  "$CI_JOBS_DIR/blog/bin/ci" || return 1
  cd "$CI_JOBS_DIR/blog" && "$b" d job send_welcome && "$b" doctor && cd "$OLDPWD" || return 1
  "$CI_JOBS_DIR/blog/bin/ci"
}

teardown_jobs() {
  [ -f "$CI_JOBS_DIR/blog/docker-compose.yml" ] || { echo "nothing to tear down"; return 0; }
  (cd "$CI_JOBS_DIR/blog" && docker compose down -v --remove-orphans)
}

# The generated app's bin/ci started a compose stack named blog-service.
# Stop it and drop its volume so a run leaves nothing behind and the next one
# starts from an empty database, which is the state every new app starts in.
teardown() {
  [ -f "$CI_APP_DIR/blog/docker-compose.yml" ] || { echo "nothing to tear down"; return 0; }
  (cd "$CI_APP_DIR/blog" && docker compose down -v --remove-orphans)
}

# A green run leaves nothing in /tmp; a failed one keeps the app for a look.
cleanup() {
  if [ "$failed" -eq 0 ]; then rm -rf "$CI_APP_DIR" "$CI_JOBS_DIR"; fi
}

signoff() {
  if [ -n "$(git status --porcelain)" ]; then
    echo "working tree has uncommitted changes; commit them and run bin/ci again to sign off"
    return 0
  fi
  if ! gh extension list 2>/dev/null | grep -q signoff; then
    echo "gh signoff is not installed (gh extension install basecamp/gh-signoff); green, but not recorded"
    return 0
  fi
  gh signoff
}

step "Setup: modules"               "go mod download && go mod verify"
step "Style: gofmt"                 "test -z \"\$(gofmt -l .)\" || { gofmt -l .; exit 1; }"
step "Style: go vet"                "go vet ./..."
step "Style: golangci-lint"         "lint"
step "Tests: the tool"              "go test -race -cover ./..."
step "Generated app: its own bin/ci" "scaffold"
step "Generated app: image builds"   "image"
step "Generators: into that app"    "generators"
step "Generated app: serves"        "serves"
step "Generated app: live reload"   "reloads"
step "Generated app: tear down"     "teardown"
step "With --jobs: scaffold, g job, d job, its own bin/ci" "jobs"
step "With --jobs: tear down"       "teardown_jobs"

printf '\n'
cleanup
if [ "$failed" -eq 0 ]; then
  printf '\033[32mAll systems go\033[0m in %ss. Ready for merge and deploy.\n' "$(( $(date +%s) - started ))"
  step "Signoff" "signoff"
  exit "$failed"
else
  printf '\033[31mCI failed\033[0m in %ss. Do not merge or deploy. Generated app left at %s\n' "$(( $(date +%s) - started ))" "$CI_APP_DIR"
  exit 1
fi
